---
// character creator: eigenständige seite im canvas-look mit subtilem
// morrowind-einschlag. 266 sprites, endlose rerolls, platzhalter-attribute,
// klasse wird aus dem dominanten attribut "gewürfelt". speichert in localStorage.
import { SITE, url, REGISTRY } from '../../data/site.js';
import sprites from '../../data/sprites.json';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`character creator — ${SITE.name}`} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <title>character creator — {SITE.name}</title>
  </head>
  <body data-sprites={JSON.stringify(sprites.ids)} data-spritebase={url('/sprites/')} data-registry={REGISTRY}>
    <div id="topbar">
      <span class="tb-title">character creator</span>
      <span class="sp"></span>
      <a href={url('/')}>← back to the archive</a>
    </div>

    <main>
      <div class="win" id="creator">
        <div class="win-title"><span class="sq r"></span><span class="sq b"></span> ▓▒ new-character.cfg ░▓</div>
        <p class="dim opener">go on. take your time. the archive keeps no schedule.</p>
        <p class="dim small" id="regline"></p>

        <div class="row">
          <label class="lbl" for="cname">name</label>
          <input id="cname" type="text" maxlength="24" spellcheck="false" placeholder="who is operating this interface?" />
          <span class="reqerr" id="nameerr" hidden>(name required)</span>
        </div>

        <div class="row sprite-row">
          <span class="lbl">sign</span>
          <div class="spritebox">
            <img id="sprite" alt="your sprite" width="256" height="256" />
            <div class="dim small" id="spriteno">sprite #— / {sprites.count}</div>
          </div>
          <button id="reroll" class="tinybtn">reroll ⚂</button>
        </div>

        <div class="row">
          <span class="lbl">attributes</span>
          <div class="stats">
            <div class="dim small" id="pool">10 points unassigned</div>
            <span class="reqerr" id="poolerr" hidden>(assign all points)</span>
            <div id="statrows"></div>
          </div>
        </div>

        <div class="row">
          <span class="lbl">class</span>
          <div class="classbox">
            <div id="cclass">—</div>
            <div class="dim small" id="cdesc">the stars have not decided.</div>
          </div>
        </div>

        <button id="create">CREATE CHARACTER</button>
        <p class="small" id="err" hidden></p>
        <p class="dim small" id="saved" hidden>
          <span id="savedlbl">saved.</span> <a id="dl" download="character.txt" href="#">download character.txt</a> ·
          <a href={url('/')}>return to the archive →</a>
        </p>
        <p class="dim small" id="restore-line">
          <a href="#" id="restore">import character →</a>
        </p>
      </div>
    </main>

    <style is:global>
      @font-face {
        font-family: 'VT323';
        src: url('../../fonts/VT323-Regular.ttf') format('truetype');
        font-display: swap;
      }
      :root {
        --bg: #1a1a1a; --win: #e9e4cf; --border: #101010;
        --shadow: #071c4a; --text: #262104; --yb: #ffe94d;
        --tb: #c9c9c9; --tb-hi: #efefef; --tb-lo: #7d7d7d;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; border-radius: 0 !important; }
      html, body {
        font-family: 'VT323', ui-monospace, monospace; font-size: 18px;
        line-height: 1.35; color: var(--text); background: var(--bg);
        background-image: radial-gradient(rgba(255, 255, 255, 0.13) 1px, transparent 1px);
        background-size: 7px 7px; image-rendering: pixelated; min-height: 100dvh;
        /* keine versehentliche auswahl beim rumklicken */
        user-select: none;
        -webkit-user-select: none;
      }
      img { -webkit-user-drag: none; user-drag: none; }
      input, textarea { user-select: text; -webkit-user-select: text; }
      a { color: inherit; }
      button { font: inherit; cursor: pointer; user-select: none; }
      .dim { opacity: 0.65; }
      .small { font-size: 15px; }
      .sp { flex: 1; }

      #topbar {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100; height: 46px;
        background: var(--tb); color: #1a1a1a; border-bottom: 2px solid var(--border);
        box-shadow: inset 0 2px 0 var(--tb-hi), inset 0 -2px 0 var(--tb-lo);
        padding: 0 16px; display: flex; gap: 14px; align-items: center;
      }
      #topbar .tb-title { font-size: 24px; letter-spacing: 2px; }
      #topbar a {
        color: #1a1a1a; text-decoration: none; font-size: 16px;
        background: var(--tb); border: 2px solid;
        border-color: var(--tb-hi) var(--tb-lo) var(--tb-lo) var(--tb-hi);
        padding: 0 8px; line-height: 22px;
      }
      #topbar a:hover { background: var(--tb-hi); }

      main { display: flex; justify-content: center; padding: 80px 16px 40px; }
      .win {
        width: min(560px, 100%); background-color: var(--win);
        border: 2px solid var(--border);
        box-shadow: 4px 4px 0 var(--shadow), inset 0 0 0 2px rgba(255, 255, 255, 0.4);
        background-image: repeating-conic-gradient(rgba(0, 0, 0, 0.055) 0% 25%, transparent 0% 50%);
        background-size: 6px 6px; padding: 10px 16px 16px;
      }
      .win-title {
        color: var(--border); background: rgba(0, 0, 0, 0.1);
        padding: 1px 6px; margin: -4px -10px 10px; white-space: nowrap; overflow: hidden;
      }
      .sq { display: inline-block; width: 8px; height: 8px; margin: 0 2px; vertical-align: middle; border: 1px solid var(--border); }
      .sq.r { background: #c81111; } .sq.b { background: #1233c8; }
      .opener { margin-bottom: 14px; font-style: italic; }

      .row { display: flex; gap: 14px; align-items: flex-start; padding: 10px 0; border-top: 2px dashed rgba(0, 0, 0, 0.2); }
      .lbl { width: 90px; flex-shrink: 0; opacity: 0.75; padding-top: 2px; }
      #cname {
        flex: 1; background: transparent; border: none;
        border-bottom: 2px solid rgba(0, 0, 0, 0.4); font: inherit; color: var(--text);
        outline: none; padding: 1px 0; caret-color: #c81111;
      }
      #cname.bad { border-bottom-color: #c81111; }
      .reqerr { color: #c81111; font-size: 15px; }

      .sprite-row { align-items: center; }
      .spritebox { flex: 1; }
      #sprite {
        display: block; width: 190px; height: 190px;
        border: 2px solid var(--border); background: #efe9d8;
        box-shadow: 3px 3px 0 var(--shadow); image-rendering: pixelated;
      }
      #sprite.flash { animation: spriteflash 0.3s ease-out; }
      /* generationen: die kopie der kopie — gespiegelt, invertiert, beides */
      .gen-2 { transform: scaleX(-1); }
      .gen-3 { filter: invert(1); }
      .gen-4 { transform: scaleX(-1); filter: invert(1); }
      @keyframes spriteflash { 0% { filter: brightness(1.8) contrast(0.6); } 100% { filter: brightness(1); } }
      .tinybtn {
        padding: 2px 10px; background: #efe9d8; border: 2px solid var(--border);
        color: #1a1503; box-shadow: 2px 2px 0 var(--shadow); font-size: 16px;
      }
      .tinybtn:active { transform: translate(2px, 2px); box-shadow: none; }

      .stats { flex: 1; }
      .statrow { display: flex; align-items: center; gap: 8px; padding: 2px 0; }
      .statrow .sname { width: 90px; font-size: 16px; }
      .statrow .bar { flex: 1; letter-spacing: 2px; font-size: 16px; }
      .statrow button {
        width: 24px; background: #efe9d8; border: 2px solid var(--border);
        box-shadow: 2px 2px 0 var(--shadow); font-size: 15px; line-height: 1.1;
      }
      .statrow button:active { transform: translate(1px, 1px); box-shadow: none; }
      .statrow button:disabled { opacity: 0.35; cursor: default; }
      #pool { margin-bottom: 4px; }

      .classbox { flex: 1; }
      #cclass { font-size: 22px; letter-spacing: 1px; }

      #create {
        display: block; width: 100%; margin-top: 14px;
        font-size: 26px; letter-spacing: 4px; padding: 12px;
        background: #c81111; color: var(--yb); border: 2px solid var(--border);
        box-shadow: 4px 4px 0 var(--shadow);
        transition: transform 0.05s, box-shadow 0.05s;
      }
      #create:active { transform: translateY(2px); box-shadow: 2px 2px 0 var(--shadow); }
      #saved { margin-top: 8px; }
    </style>

    <script>
      const $ = (id) => document.getElementById(id);
      const IDS = JSON.parse(document.body.dataset.sprites);
      const BASE = document.body.dataset.spritebase;

      // hintergrund folgt der canvas-farbwahl (settings.cfg), default schwarz
      const canvasPrefs = JSON.parse(localStorage.getItem('canvasPrefs') || '{}');
      if (canvasPrefs.bg) document.documentElement.style.setProperty('--bg', canvasPrefs.bg);

      // wechselnde eröffnungszeile
      const OPENERS = [
        'go on. take your time. the archive keeps no schedule.',
        'there are no wrong builds. only documented ones.',
        'choose carefully. or do not — both are recorded the same way.',
        'the form is short. the consequences are permanent.',
        'this will only take a moment. the moment is yours forever.',
      ];
      document.querySelector('.opener').textContent =
        OPENERS[Math.floor(Math.random() * OPENERS.length)];

      // attribute: lesen · aufnehmen · herkunft · widerstand · warten
      const STATS = ['literacy', 'bandwidth', 'provenance', 'friction', 'patience'];
      // klassenfindung in drei stufen:
      //   1. die perfekte verteilung 3/3/3/3/3 -> the reproduction
      //   2. signatur-builds (SPECIALS, reihenfolge = priorität)
      //   3. sonst: dominantes + zweites attribut -> 20 subklassen
      const CLASSES = {
        reproduction: ['the reproduction', 'perfectly distributed. indistinguishable from an original that never existed.'],
        literacy: {
          bandwidth: ['the footnote maximalist', 'the argument is in footnote 41. the footnotes have footnotes.'],
          provenance: ['the meme historian', 'cites the repost of the repost. considers the original apocryphal.'],
          friction: ['the institutional critic', 'reads the building, not the plaque.'],
          patience: ['the slow critic', 'the review is nearly finished. the work has been deleted for years.'],
        },
        bandwidth: {
          literacy: ['the dataset scavenger', 'eats what the crawlers left behind.'],
          provenance: ['the contamination archivist', 'keeps meticulous records of what got in. politely declines to remove it.'],
          friction: ['the glitch auteur', 'signs the error as if it were a decision.'],
          patience: ['the render hermit', 'left for the render farm years ago. sends frames.'],
        },
        provenance: {
          literacy: ['the forensic curator', 'exhibits the evidence. refuses to name a suspect.'],
          bandwidth: ['the rights-holder', 'owns a percentage of everything you have ever seen.'],
          friction: ['the claimant', 'files disputes against the horizon.'],
          patience: ['the conservator', 'keeps the original at 18 degrees. will not say where. will not say if.'],
        },
        friction: {
          literacy: ['the poor-image theologian', 'finds grace in the artifact of the artifact.'],
          bandwidth: ['the compression ascetic', 'believes what survives compression deserved to.'],
          provenance: ['the material witness', 'was there when it was still an object. keeps mentioning it.'],
          patience: ['the craft fundamentalist', 'insists it must hurt the hands to count.'],
        },
        patience: {
          literacy: ['the auteurist', 'waits for intent to appear in the credits.'],
          bandwidth: ['the slop auteur', 'generates until quantity confesses to being a style.'],
          provenance: ['the labor romantic', 'believes the hours are stored in the file. somewhere.'],
          friction: ['the director', 'says stop. nothing stops. says stop again.'],
        },
      };
      // signatur-builds: [prüfung, name, beschreibung] — erste treffende gewinnt
      const SPECIALS = [
        [(s) => s.literacy === 5 && s.friction === 5,
          'the adversarial user', 'reads the terms of service in full, as a weapon.'],
        [(s) => s.friction === 5 && s.bandwidth === 1,
          'the refuser', 'has considered the content and would prefer not to.'],
        [(s) => s.bandwidth === 5 && s.provenance === 1,
          'the middleman', 'forwards everything. attribution pending since 2014.'],
        [(s) => s.patience === 5 && s.literacy === 1,
          'the sleeper', 'has not opened the file. will not open the file. guards the file.'],
        [(s) => s.provenance === 1 && s.literacy >= 4,
          'the revisionist', 'remembers it differently. has sources. will not show them.'],
        [(s) => s.bandwidth >= 4 && s.friction === 1,
          'the normie', 'scrolls. likes. is, statistically, the audience.'],
        [(s) => STATS.every((k) => s[k] >= 2 && s[k] <= 4) && STATS.filter((k) => s[k] === 4).length <= 1,
          'the model citizen', 'flags nothing. breaks nothing. the system has no notes.'],
      ];
      const POOL = 10, MAX = 5;

      const REG = document.body.dataset.registry;
      let taken = new Set();
      let gen = 1;

      const saved = JSON.parse(localStorage.getItem('mpwCharacter') || 'null');
      let spriteIdx = saved ? IDS.indexOf(saved.sprite) : Math.floor(Math.random() * IDS.length);
      if (spriteIdx < 0) spriteIdx = 0;
      // alte gespeicherte charaktere mit anderen attribut-namen: stats zurücksetzen
      const stats =
        saved?.stats && STATS.every((s) => s in saved.stats)
          ? { ...saved.stats }
          : Object.fromEntries(STATS.map((s) => [s, 1]));
      if (saved?.name) $('cname').value = saved.name;

      // existiert bereits ein charakter, wird die seite zur akte:
      // nichts ist mehr veränderbar (entscheidung auf lebenszeit), aber
      // export (character.txt) und restore bleiben immer erreichbar
      const locked = !!saved;

      // generation-optik: gen 2 gespiegelt, gen 3 invertiert, gen 4 beides —
      // danach beginnt der zyklus von vorn (die kopie der kopie der kopie)
      const genClass = (g) => 'gen-' + (((g - 1) % 4) + 1);

      const freeIdxs = () => IDS.map((id, i) => i).filter((i) => !taken.has(IDS[i]));
      const randomFree = () => {
        const free = freeIdxs();
        return free.length ? free[Math.floor(Math.random() * free.length)] : spriteIdx;
      };

      async function loadRegistry() {
        if (!REG) {
          $('regline').textContent = 'local mode — this character exists only in this browser.';
          return;
        }
        try {
          const s = await (await fetch(REG + '/status')).json();
          gen = s.gen;
          taken = new Set(s.taken);
          $('regline').textContent = `generation ${s.gen} · ${s.remaining} of ${IDS.length} sprites remain · every character exists once`;
          if (!locked) $('sprite').className = genClass(gen);
          if (taken.has(IDS[spriteIdx]) && !saved) {
            spriteIdx = randomFree();
            render();
          }
        } catch {
          $('regline').textContent = 'registry unreachable — running in local mode.';
        }
      }

      const spent = () => STATS.reduce((a, s) => a + stats[s] - 1, 0);

      function classOf() {
        if (STATS.every((s) => stats[s] === 3)) return CLASSES.reproduction;
        for (const [test, name, desc] of SPECIALS) {
          if (test(stats)) return [name, desc];
        }
        const order = [...STATS].sort(
          (a, b) => stats[b] - stats[a] || STATS.indexOf(a) - STATS.indexOf(b)
        );
        return CLASSES[order[0]][order[1]];
      }

      function render() {
        $('sprite').src = BASE + IDS[spriteIdx] + '.webp';
        $('spriteno').textContent = `sprite #${IDS[spriteIdx]} / ${IDS.length}`;
        const free = POOL - spent();
        $('pool').textContent = locked
          ? 'assigned. for life.'
          : free === 0 ? 'all points assigned' : `${free} point${free === 1 ? '' : 's'} unassigned`;
        $('statrows').innerHTML = STATS.map((s) => `
          <div class="statrow">
            <span class="sname">${s}</span>
            <button data-s="${s}" data-d="-1" ${locked || stats[s] <= 1 ? 'disabled' : ''}>−</button>
            <span class="bar">${'▮'.repeat(stats[s])}${'▯'.repeat(MAX - stats[s])}</span>
            <button data-s="${s}" data-d="1" ${locked || stats[s] >= MAX || free <= 0 ? 'disabled' : ''}>+</button>
          </div>`).join('');
        const [name, desc] = classOf();
        $('cclass').textContent = name;
        $('cdesc').textContent = 'the stars suggest: ' + desc;
      }

      $('statrows').addEventListener('click', (e) => {
        if (locked) return;
        const b = e.target.closest('button[data-s]');
        if (!b || b.disabled) return;
        stats[b.dataset.s] += Number(b.dataset.d);
        if (spent() === POOL) $('poolerr').hidden = true;
        render();
      });

      // reroll würfelt alles: sprite UND die komplette punkteverteilung.
      // unendlich oft erlaubt; im registry-modus nur über freie sprites.
      const randomStats = () => {
        STATS.forEach((s) => (stats[s] = 1));
        for (let i = 0; i < POOL; i++) {
          const open = STATS.filter((s) => stats[s] < MAX);
          stats[open[Math.floor(Math.random() * open.length)]]++;
        }
      };
      let rolling = false;
      $('reroll').addEventListener('click', () => {
        if (rolling || locked) return;
        rolling = true;
        let t = 0;
        const iv = setInterval(() => {
          spriteIdx = randomFree();
          randomStats();
          render();
          if (++t >= 7) {
            clearInterval(iv);
            $('poolerr').hidden = true;
            $('sprite').classList.add('flash');
            setTimeout(() => $('sprite').classList.remove('flash'), 320);
            rolling = false;
          }
        }, 70);
      });

      const showErr = (msg) => {
        $('err').textContent = msg;
        $('err').hidden = false;
      };

      function persist(character) {
        localStorage.setItem('mpwCharacter', JSON.stringify(character));
        // WICHTIG: format synchron halten mit dem export im charwin (startseite)
        const lines = [
          '== moepwellington.xyz — character file ==',
          '',
          'this file IS your character. keep it safe.',
          'to bring the character back (new browser, new device):',
          'moepwellington.xyz -> import character -> paste the',
          'ENTIRE contents of this file. that is all.',
          '',
          `name:      ${character.name}`,
          `class:     ${character.klass}`,
          `sprite:    #${character.sprite} / ${IDS.length}`,
          character.num ? `character: #${character.num} · generation ${character.gen}` : 'mode:      local',
          `stats:     ${STATS.map((s) => `${s} ${character.stats[s]}`).join(' · ')}`,
          `created:   ${character.created}`,
          '',
          character.token
            ? `recovery token — the only proof this character is yours. do not share it:\n${character.token}`
            : 'no token — local character, lives in this browser only.',
        ].join('\n');
        $('dl').href = URL.createObjectURL(new Blob([lines], { type: 'text/plain' }));
        $('err').hidden = true;
        $('saved').hidden = false;
        $('saved').scrollIntoView({ block: 'nearest' });
      }

      $('cname').addEventListener('input', () => {
        $('nameerr').hidden = true;
        $('cname').classList.remove('bad');
      });

      $('create').addEventListener('click', async () => {
        if (locked) return;
        const name = $('cname').value.trim();
        // pflichtfelder: ohne name und ohne volle punkteverteilung kein charakter
        let blocked = false;
        if (!name) {
          $('nameerr').hidden = false;
          $('cname').classList.add('bad');
          blocked = true;
        }
        if (spent() !== POOL) {
          $('poolerr').hidden = false;
          blocked = true;
        }
        if (blocked) return;
        const [klass] = classOf();
        const base = { name, sprite: IDS[spriteIdx], stats, klass, created: new Date().toISOString() };
        if (!REG) {
          persist({ ...base, created: saved?.created || base.created });
          return;
        }
        $('create').disabled = true;
        try {
          const res = await fetch(REG + '/claim', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ sprite: IDS[spriteIdx], name, stats, klass }),
          });
          const data = await res.json();
          if (res.status === 201) {
            persist({ ...base, num: data.num, gen: data.gen, token: data.token, created: data.created });
          } else if (data.error === 'name_taken') {
            showErr('this name is already walking the archive. choose another.');
          } else if (data.error === 'sprite_taken') {
            showErr('someone claimed this sprite seconds ago. rerolling…');
            await loadRegistry();
            spriteIdx = randomFree();
            render();
          } else {
            showErr('the registry refused. try again.');
          }
        } catch {
          showErr('registry unreachable. try again later.');
        }
        $('create').disabled = false;
      });

      // wiederherstellung: token ODER komplette character.txt einfügen.
      // kennt der server die attribute nicht (alte claims), werden sie aus
      // der eingefügten datei gelesen und per /repair dauerhaft nachgetragen
      $('restore').addEventListener('click', async (e) => {
        e.preventDefault();
        if (!REG) return showErr('local mode — nothing to restore from.');
        const input = prompt('paste the entire contents of your character.txt:');
        if (!input) return;
        // token aus beliebigem text fischen (doppel-uuid, 73 zeichen)
        const tm = input.match(/[0-9a-f-]{60,90}/i);
        const token = (tm ? tm[0] : input).trim();
        // stats-zeile der character.txt: "literacy 3 · bandwidth 2 · …"
        const fileStats = {};
        for (const s of STATS) {
          const m = input.match(new RegExp(s + '\\s+([0-9])'));
          if (m) fileStats[s] = Number(m[1]);
        }
        const hasAll = (o) => o && STATS.every((s) => s in o);
        try {
          const res = await fetch(REG + '/me?token=' + encodeURIComponent(token));
          if (!res.ok) return showErr('unknown token. the archive does not remember you.');
          let c = await res.json();
          if (!hasAll(c.stats) && hasAll(fileStats)) {
            const r = await fetch(REG + '/repair', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ token, stats: fileStats, klass: c.klass }),
            }).catch(() => null);
            if (r && r.ok) c = await r.json();
            else c.stats = fileStats;
          }
          if (hasAll(c.stats)) Object.assign(stats, c.stats);
          else showErr('note: the registry has no attributes for this character — paste your full character.txt to restore them.');
          persist({
            name: c.name, sprite: c.sprite, num: c.num, gen: c.gen,
            stats, klass: c.klass || classOf()[0], token, created: c.created,
          });
          spriteIdx = Math.max(0, IDS.indexOf(c.sprite));
          $('cname').value = c.name;
          render();
          // vollständig wiederhergestellt: seite neu laden -> gesperrte akte
          if (hasAll(c.stats)) location.reload();
        } catch {
          showErr('registry unreachable. try again later.');
        }
      });

      if (locked) {
        // die akte: alles sichtbar, nichts veränderbar — nur export + restore
        document.querySelector('#creator .win-title').innerHTML =
          '<span class="sq r"></span><span class="sq b"></span> ▓▒ character.cfg ░▓';
        document.querySelector('.opener').textContent =
          'the archive already remembers you. this was a decision for life.';
        $('cname').disabled = true;
        $('reroll').hidden = true;
        // style statt hidden-attribut: #create hat display:block im css
        $('create').style.display = 'none';
        if (saved.gen) $('sprite').className = genClass(saved.gen);
        $('savedlbl').textContent = 'this character is on file.';
        persist(saved); // baut den download-link und blendet die zeile ein
      }
      render();
      loadRegistry();
    </script>
  </body>
