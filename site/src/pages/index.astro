            <label for="gridtoggle">grid</label>
            <input type="checkbox" id="gridtoggle" checked />
            <label for="sagslider" class="saglbl">sag</label>
            <input type="range" id="sagslider" min="0" max="200" step="10" value="100" />
            <span id="sagval">100%</span>
          </div>
          <div class="swrow btnrow">
            <button class="tinybtn" id="swreset">reset</button>
            <button class="tinybtn" id="swrnd" title="randomize colors">⚂</button>
          </div>
          <div class="swrow btnrow">
            <button class="tinybtn" id="laysave" title="save current window layout">save layout</button>
            <button class="tinybtn" id="laylock" title="lock window positions">lock</button>
            <button class="tinybtn" id="layreset" title="restore default layout">reset layout</button>
          </div>
        </div>
      </div>
    </div>

    <!-- gelocktes charakter-fenster: fix in der ecke, unabhängig von der kamera -->
    <div id="charwin" class="hidden" data-spritebase={url('/sprites/')} data-href={url('/character-creator/')}>
      <div class="win-title"><span class="sq y"></span><span class="sq r"></span> ▒▓ you ░▒</div>
      <img id="charimg" alt="your character" width="256" height="256" title="stats" />
      <div id="charname"></div>
      <div id="charclass" class="small dim"></div>
      <div id="chardetail">
        <hr class="chr" />
        <div id="charstats"></div>
      </div>
      <hr class="chr" />
      <div id="charno" class="small dim"></div>
    </div>

    <div id="zoomctl">
      <button id="zoomout">−</button>
      <span id="zoomlvl">100%</span>
      <button id="zoomin">+</button>
      <button id="zoomfit" title="fit everything into view">fit</button>
    </div>

    <dialog id="lb">
      <div class="lbframe">
        <img alt="" />
        <div class="lbbar">
          <button data-nav="-1">← prev</button>
          <span id="lbtitle"></span>
          <button data-nav="1">next →</button>
          <button id="lblike" title="like">♥</button>
          <button id="lbrnd" title="random work from current selection">rnd ⚂</button>
          <button id="lbclose">esc close</button>
        </div>
      </div>
    </dialog>

    <script type="application/json" id="works-data" set:html={worksJson} />

    <style is:global>
      @font-face {
        font-family: 'VT323';
        src: url('../fonts/VT323-Regular.ttf') format('truetype');
        font-display: swap;
      }
      :root {
        --bg: #242424;
        --win: #b9bdb2;
        --win-alt: #b9bdb2;
        --cable: #ffe94d;
        --border: #101010;
        --shadow: #0d0d0d;
        --text: #262104;
        --yb: #ffe94d;
        --tb: #c9c9c9;
        --tb-hi: #efefef;
        --tb-lo: #7d7d7d;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; border-radius: 0 !important; }
      html, body {
        font-family: 'VT323', ui-monospace, monospace;
        font-size: 18px;
        line-height: 1.3;
        color: var(--text);
        background: var(--bg);
        image-rendering: pixelated;
        overscroll-behavior: none;
        /* keine versehentliche text-/bildauswahl beim navigieren */
        user-select: none;
        -webkit-user-select: none;
      }
      img { -webkit-user-drag: none; user-drag: none; }
      input, textarea { user-select: text; -webkit-user-select: text; }
      a { color: inherit; }
      button { font: inherit; cursor: pointer; user-select: none; }
      .hidden { display: none !important; }
      .dim { opacity: 0.65; }
      .small { font-size: 15px; }
      .sp { flex: 1; }

      /* topbar: klassische graue os-leiste — neutral zu jeder canvas-farbe */
      #topbar {
        position: fixed; top: 0; left: 0; right: 0; z-index: 100; height: 46px;
        background: var(--tb); color: #1a1a1a;
        border-bottom: 2px solid var(--border);
        box-shadow: inset 0 2px 0 var(--tb-hi), inset 0 -2px 0 var(--tb-lo);
        padding: 0 16px;
        display: flex; gap: 14px; align-items: center;
        white-space: nowrap; overflow: hidden;
      }
      /* vt323 hat keinen bold-schnitt — faux-bold sah kaputt aus, also regular + größer */
      #topbar .tb-title { font-weight: normal; font-size: 24px; letter-spacing: 2px; }
      #topbar a {
        color: #1a1a1a; text-decoration: none; font-size: 16px;
        background: var(--tb); border: 2px solid;
        border-color: var(--tb-hi) var(--tb-lo) var(--tb-lo) var(--tb-hi);
        padding: 0 8px; line-height: 22px;
      }
      #topbar a:hover { background: var(--tb-hi); }
      #topbar a:active { border-color: var(--tb-lo) var(--tb-hi) var(--tb-hi) var(--tb-lo); }
      #helpbtn {
        width: 26px; height: 26px; line-height: 1; font-weight: bold;
        background: var(--tb); border: 2px solid;
        border-color: var(--tb-hi) var(--tb-lo) var(--tb-lo) var(--tb-hi);
      }
      #helpbtn:hover { background: var(--tb-hi); }
      #helpbtn:active, #helpbtn.on { border-color: var(--tb-lo) var(--tb-hi) var(--tb-hi) var(--tb-lo); }
      #helpwin {
        position: fixed; top: 54px; right: 12px; z-index: 110; width: 330px;
        background: var(--win-alt); border: 2px solid var(--border);
        box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.45); padding: 8px 12px 12px;
      }
      #helpwin pre { font: inherit; font-size: 15px; }
      #helpwin .win-title { margin: -2px -6px 8px; }

      /* punktraster liegt auf dem viewport (nicht auf dem skalierten canvas):
         js hält size/position synchron zu pan+zoom → unendlich + kein moiré */
      #vp {
        position: fixed; inset: 46px 0 0 0; overflow: hidden;
        cursor: grab; touch-action: none;
        background-image: radial-gradient(rgba(255, 255, 255, 0.13) 1px, transparent 1px);
        background-size: 7px 7px;
      }
      #vp.panning { cursor: grabbing; }
      #canvas {
        position: absolute; width: 3200px; height: 2200px;
        transform-origin: 0 0;
      }
      #cables { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; z-index: 5; overflow: visible; }

      .win {
        position: absolute; z-index: 10;
        background-color: var(--win);
        border: 2px solid var(--border);
        box-shadow: 4px 4px 0 var(--shadow), inset 0 0 0 2px rgba(255, 255, 255, 0.4);
        background-image: repeating-conic-gradient(rgba(0, 0, 0, 0.055) 0% 25%, transparent 0% 50%);
        background-size: 6px 6px;
        padding: 10px 12px 12px;
      }
      .win.alt { background-color: var(--win-alt); }
      .win::before, .win::after {
        content: ""; position: absolute; width: 9px; height: 9px;
        background: var(--cable); border: 2px solid var(--border); top: 18px; z-index: 3;
      }
      .win::before { left: -7px; }
      .win::after { right: -7px; }
      .win-title {
        color: var(--border); background: rgba(0, 0, 0, 0.1);
        padding: 1px 6px; margin: -4px -6px 8px; cursor: move;
        white-space: nowrap; overflow: hidden; user-select: none;
      }
      .sq { display: inline-block; width: 8px; height: 8px; margin: 0 2px; vertical-align: middle; border: 1px solid var(--border); }
      .sq.r { background: #c81111; } .sq.b { background: #1233c8; } .sq.y { background: #ffe94d; }

      .grip {
        position: absolute; right: 0; bottom: 0; width: 18px; height: 18px;
        cursor: nwse-resize; z-index: 4;
        background: repeating-linear-gradient(135deg, transparent 0 3px, var(--border) 3px 5px);
      }

      .tree { font: inherit; font-size: 15px; white-space: pre; }
      .tree a { color: var(--text); }
      .tree a:hover { color: #1233c8; }
      .toggles { display: flex; flex-direction: column; }
      .trow {
        display: block; width: 100%; text-align: left;
        background: none; border: none; color: var(--text);
        font: inherit; font-size: 15px; white-space: pre; padding: 0;
        line-height: 1.45;
      }
      .trow:hover { background: rgba(0, 0, 0, 0.12); }
      /* unterpunkte von character-creator: nur das label unterstreichen */
      .charrow { text-decoration: none; }
      .trow .ind { font-weight: bold; }
      .trow.on .ind { color: #1a7a12; }

      .loadbtn, .tinybtn {
        display: block; width: 100%; margin-top: 6px; padding: 2px 8px;
        background: #efe9d8; border: 2px solid var(--border); color: #1a1503;
        box-shadow: 3px 3px 0 var(--shadow); text-align: left;
      }
      .tinybtn { display: inline-block; width: auto; box-shadow: 2px 2px 0 var(--shadow); font-size: 15px; }
      /* viewer-steuerung im roten look von generate.exe / create character */
      #vprev, #vnext { background: #c81111; color: var(--yb); }
      .loadbtn:active, .tinybtn:active { transform: translate(2px, 2px); box-shadow: none; }
      .loadbtn.on { background: var(--border); color: var(--yb); }

      /* generate.exe — gen-button aus dem spiel übernommen */
      #genprompt {
        display: block; width: 100%;
        background: transparent; border: none; border-bottom: 2px solid rgba(0, 0, 0, 0.4);
        font: inherit; font-size: 15px; color: var(--text); outline: none;
        padding: 2px 0; caret-color: #c81111;
      }
      #genbtn {
        display: block; width: 100%; margin-top: 10px;
        font-size: 26px; letter-spacing: 4px; padding: 10px;
        background: #c81111; color: #ffe94d; border: 2px solid var(--border);
        box-shadow: 4px 4px 0 var(--shadow);
        transition: transform 0.05s, box-shadow 0.05s, background 0.05s;
      }
      #genbtn.flash, #genbtn:active { background: #8f0b0b; transform: translateY(2px); box-shadow: 2px 2px 0 var(--shadow); }
      #genbtn:disabled { opacity: 0.7; cursor: wait; }
      @media (prefers-reduced-motion: reduce) { #genbtn.flash { transform: none; } }
      #genlog { font: inherit; font-size: 14px; margin-top: 8px; min-height: 1.3em; white-space: pre-wrap; overflow-wrap: anywhere; }
      #win-about p { margin-bottom: 8px; }
      .ccline { font: inherit; font-size: 14px; }
      .ccbtn {
        display: block; text-align: center; text-decoration: none;
        font-size: 20px; letter-spacing: 3px; padding: 8px;
        background: #c81111; color: var(--yb); border: 2px solid var(--border);
        box-shadow: 3px 3px 0 var(--shadow);
      }
      .ccbtn:active { transform: translate(2px, 2px); box-shadow: none; }

      /* gelocktes charakter-fenster unten rechts, bündig über der zoom-leiste.
         fixed, kamera-unabhängig; über die character-creator-zeile minimierbar.
         minimal: stats erst bei hover / klick aufs bild (wächst nach oben) */
      #charwin {
        position: fixed; right: 16px; bottom: 68px; z-index: 90; width: 192px;
        background-color: var(--win-alt); border: 2px solid var(--border);
        box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.45), inset 0 0 0 2px rgba(255, 255, 255, 0.4);
        background-image: repeating-conic-gradient(rgba(0, 0, 0, 0.055) 0% 25%, transparent 0% 50%);
        background-size: 6px 6px; padding: 8px 12px 10px;
      }
      #charwin .win-title { cursor: default; margin: -2px -6px 8px; }
      #charimg {
        display: block; width: 100%; height: auto;
        border: 2px solid var(--border); background: #efe9d8;
        image-rendering: pixelated; margin-bottom: 6px; cursor: pointer;
      }
      #chardetail { display: none; }
      @media (hover: hover) { #charwin:hover #chardetail { display: block; } }
      #charwin.exp #chardetail { display: block; }
      #charname { font-size: 19px; letter-spacing: 1px; overflow-wrap: anywhere; }
      #charwin .chr { border: none; border-top: 2px dashed rgba(0, 0, 0, 0.25); margin: 7px 0; }
      .csrow { display: flex; justify-content: space-between; font-size: 13px; opacity: 0.85; line-height: 1.5; }
      .csrow .csbar { letter-spacing: 1px; }
      /* generationen-optik wie im creator */
      #charimg.gen-2 { transform: scaleX(-1); }
      #charimg.gen-3 { filter: invert(1); }
      #charimg.gen-4 { transform: scaleX(-1); filter: invert(1); }

      /* teaser: flash-ära banner — dither-textur, funkelnde sterne,
         pumpender text, pulsierender pfeil mit lauflicht-shine. der pfeil
         spiegelt sich, wenn das fenster rechts vom portfolio hängt — der
         text bleibt dabei bewusst ungespiegelt lesbar */
      /* popup-chrome: bewusst NICHT im look der anderen fenster — blauer
         verlaufs-balken, weisse schrift, echtes X. leicht unseriös, subtil */
      #win-teaser { background-color: #efe9d8; box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.6); }
      #win-teaser .win-title {
        display: flex; align-items: center; gap: 6px;
        background: linear-gradient(90deg, #1233c8, #4a90d9);
        color: #fff; font-size: 15px;
      }
      #win-teaser .tad { font-size: 11px; color: #ffe94d; }
      #teaserx {
        width: 18px; height: 16px; line-height: 1; padding: 0; flex: none;
        background: #c9c9c9; color: #1a1a1a; border: 1px solid;
        border-color: #efefef #7d7d7d #7d7d7d #efefef; font-size: 13px;
      }
      #teaserx:hover { background: #c81111; color: #ffe94d; }
      #teaser {
        display: block; position: relative; overflow: hidden;
        text-align: center; text-decoration: none; padding: 3px 0 4px;
        background-image: repeating-conic-gradient(rgba(0, 0, 0, 0.09) 0% 25%, transparent 0% 50%);
        background-size: 8px 8px;
      }
      .tspark {
        position: absolute; font-size: 15px; color: #ffe94d;
        text-shadow: 1px 1px 0 var(--border);
        animation: tsp 0.9s steps(2) infinite;
      }
      .tspark.s1 { left: 7px; top: 6px; }
      .tspark.s2 { right: 9px; top: 20px; animation-delay: 0.22s; color: #c81111; }
      .tspark.s3 { left: 12px; bottom: 30px; animation-delay: 0.45s; }
      .tspark.s4 { right: 7px; bottom: 12px; animation-delay: 0.68s; color: #e8a01c; }
      @keyframes tsp { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.15; transform: scale(0.55) rotate(45deg); } }
      #teasertxt {
        display: block; font-size: 22px; letter-spacing: 2px; color: #c81111;
        text-shadow: 2px 2px 0 #ffe94d;
        animation: tpump 0.6s steps(2) infinite;
      }
      @keyframes tpump {
        0% { color: #c81111; text-shadow: 2px 2px 0 #ffe94d; transform: translateY(0); }
        50% { color: #e8a01c; text-shadow: 2px 2px 0 #c81111; transform: translateY(-1px); }
      }
      #tarrww { display: block; animation: tjig 0.5s steps(2) infinite; }
      @keyframes tjig { 0% { transform: translate(0, 0); } 50% { transform: translate(3px, -3px); } }
      #teaserarrow { display: block; width: 114px; margin: 1px 6px 1px auto; transform: rotate(-24deg); }
      #win-teaser.flip #teaserarrow { transform: scaleX(-1) rotate(-24deg); margin: 1px auto 1px 6px; }
      #win-teaser.flip #tarrww { animation-direction: reverse; }
      .ta-body { fill: #c81111; stroke: var(--border); stroke-width: 4; animation: tafill 0.8s steps(2) infinite; }
      @keyframes tafill { 0% { fill: #c81111; } 50% { fill: #e8501e; } }
      .ta-shine { fill: rgba(255, 255, 255, 0.75); animation: tshine 0.5s steps(2) infinite; }
      @keyframes tshine { 0% { opacity: 1; } 50% { opacity: 0; } }
      #teasertxt2 {
        display: block; font-size: 15px; letter-spacing: 1px; color: var(--text);
        animation: tsp 0.7s steps(2) 0.1s infinite;
      }
      #teasertxt3 {
        display: block; font-size: 11px; color: #7a7460; letter-spacing: 0.5px;
        border-top: 1px dotted #9a9480; margin: 3px 6px 0; padding-top: 2px;
      }
      @media (prefers-reduced-motion: reduce) {
        #teasertxt, #teasertxt2, #tarrww, .tspark, .ta-body, .ta-shine { animation: none; }
      }

      /* feedback.exe */
      #fbtext {
        display: block; width: 100%; margin-top: 6px; resize: vertical;
        background: #efe9d8; border: 2px solid var(--border);
        font: inherit; font-size: 15px; color: var(--text); padding: 4px 6px; outline: none;
      }
      #fbhp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
      #fbsend {
        display: block; width: 100%; margin-top: 6px; padding: 4px 8px;
        font-size: 18px; letter-spacing: 2px;
        background: #c81111; color: #ffe94d; border: 2px solid var(--border);
        box-shadow: 3px 3px 0 var(--shadow);
      }
      #fbsend:active { transform: translate(2px, 2px); box-shadow: none; }
      #fbsend:disabled { opacity: 0.7; cursor: wait; }
      #fbstatus { margin-top: 4px; min-height: 1.2em; }

      /* likes: bewusst leise — ein herz, mehr nicht */
      .likebtn {
        background: none; border: none; padding: 0 2px; font: inherit;
        font-size: 19px; line-height: 1; color: var(--text); opacity: 0.5; flex-shrink: 0;
      }
      .likebtn:hover { opacity: 0.8; }
      .likebtn.on { opacity: 1; color: #c81111; }
      #lblike.on { color: #c81111; border-color: #c81111; }

      /* cull.exe — gast-kuration */
      #cullstrip { display: flex; flex-wrap: wrap; gap: 4px; max-height: 140px; overflow-y: auto; margin: 4px 0 2px; }
      .cullthumb { width: 40px; height: 40px; object-fit: cover; border: 2px solid var(--border); background: #efe9d8; cursor: grab; -webkit-user-drag: element; user-drag: element; }
      /* kept-fenster: grosse thumbs, scrollbar, gleiche reorder-logik */
      #keptgrid { display: flex; flex-wrap: wrap; gap: 6px; max-height: 520px; overflow-y: auto; margin-top: 6px; }
      #keptgrid .cullthumb { width: 92px; height: 92px; }
      #cullmax { background: #c81111; color: #ffe94d; }
      .cullthumb:active { cursor: grabbing; }
      #cullempty p, #cullstate .loadbtn { margin-bottom: 6px; }
      #cullzip:disabled { opacity: 0.55; cursor: default; }

      /* trash.bin — desktop-icon, bewusst stilbruch zu den fenstern */
      #trashicon {
        position: absolute; left: 1560px; top: 1180px; z-index: 8;
        width: 76px; text-align: center; cursor: pointer; user-select: none;
        image-rendering: pixelated;
      }
      #trashicon svg { width: 51px; display: block; margin: 0 auto; }
      #trashicon .tlabel {
        display: inline-block; font-size: 13px; letter-spacing: 0;
        color: #fff; margin-top: 1px; padding: 0 3px;
        text-shadow: 1px 1px 0 #000;
      }
      #trashicon:hover .tlabel, #trashicon.dragging .tlabel {
        background: #1233c8; outline: 1px dotted #fff; text-shadow: none;
      }
      #trashicon.empty .t-paper { display: none; }
      #trashgrid { display: flex; flex-wrap: wrap; gap: 4px; max-height: 220px; overflow-y: auto; margin: 6px 0; }
      #trashgrid img { width: 40px; height: 40px; object-fit: cover; border: 2px solid var(--border); background: #efe9d8; cursor: pointer; opacity: 0.75; }
      #trashgrid img:hover { opacity: 1; outline: 2px solid #57c94f; }

      /* residents.log — gästebuch: kompakte zeilen, klick öffnet die akte */
      /* höhe per grabber unten rechts selbst einstellbar */
      #bookscroll { height: 240px; min-height: 80px; max-height: 560px; resize: vertical; overflow-y: auto; margin-top: 6px; }
      .bkrow {
        display: flex; gap: 8px; align-items: center; width: 100%;
        padding: 5px 2px; background: none; border: none; text-align: left;
        color: var(--text); font: inherit;
        border-top: 2px dashed rgba(0, 0, 0, 0.2);
      }
      .bkrow:first-child { border-top: none; }
      .bkrow:hover, .bkrow.open { background: rgba(0, 0, 0, 0.1); }
      .bkrow img { width: 36px; height: 36px; border: 2px solid var(--border); background: #efe9d8; image-rendering: pixelated; flex-shrink: 0; }
      .bkname { font-size: 16px; overflow-wrap: anywhere; min-width: 0; flex: 1; }
      .bknum { flex-shrink: 0; }
      .bkdetail { padding: 4px 2px 10px 10px; }
      .bkdetail .csrow { max-width: 230px; }
      .bkmeta { margin-top: 4px; }

      /* archive activity */
      #actgraph { display: block; margin-bottom: 6px; }
      #actgraph rect { stroke: var(--border); stroke-width: 1.5; }

      /* store */
      .stitem {
        display: flex; gap: 8px; align-items: center;
        padding: 7px 0; border-top: 2px dashed rgba(0, 0, 0, 0.25);
      }
      .stitem:first-of-type { border-top: none; }
      .stitem img { width: 52px; height: 52px; object-fit: cover; border: 2px solid var(--border); background: #efe9d8; flex-shrink: 0; }
      .stinfo { flex: 1; min-width: 0; }
      .stbuy { text-align: right; flex-shrink: 0; }
      .stprice { font-size: 16px; }
      .buybtn {
        display: inline-block; padding: 1px 8px; text-decoration: none;
        background: #c81111; color: #ffe94d; border: 2px solid var(--border);
        box-shadow: 2px 2px 0 var(--shadow); font-size: 15px;
      }
      .buybtn:active { transform: translate(2px, 2px); box-shadow: none; }
      .stflag { font-size: 14px; opacity: 0.6; }
      .stnotice { margin-top: 8px; border-top: 2px solid rgba(0, 0, 0, 0.25); padding-top: 6px; }

      .thumbrow { display: flex; gap: 6px; margin-bottom: 4px; }
      .thumbrow img { width: 64px; height: 64px; object-fit: cover; border: 2px solid var(--border); background: #efe9d8; }

      .vbar { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; flex-wrap: wrap; }
      /* guest mode: 1-window-lock — slider komplett ausblenden */
      #win-viewer.guest .slotlbl, #win-viewer.guest #slots, #win-viewer.guest #slotcount { display: none; }
      /* feste breite, damit "9/39" -> "10/39" die zeile nicht umbrechen lässt */
      #vpage { min-width: 3.4em; text-align: center; }
      #slots { width: 90px; accent-color: var(--cable); }
      #vslots { display: grid; gap: 10px; }
      #vslots[data-slots='1'] { grid-template-columns: 1fr; }
      #vslots[data-slots='2'] { grid-template-columns: 1fr 1fr; }
      #vslots[data-slots='3'] { grid-template-columns: 1fr 1fr 1fr; }
      #vslots[data-slots='4'] { grid-template-columns: 1fr 1fr; }
      #vslots figure { margin: 0; }
      #vslots img {
        display: block; width: 100%; height: auto; aspect-ratio: 1;
        object-fit: cover; border: 2px solid var(--border);
        background: #efe9d8; box-shadow: 3px 3px 0 var(--shadow); cursor: zoom-in;
      }
      /* einzelansicht: echtes seitenverhältnis, kein beschnitt (hoch-/querformat ok) */
      #vslots[data-slots='1'] img { aspect-ratio: auto; object-fit: contain; }
      #vslots figcaption { font-size: 15px; padding-top: 2px; display: flex; align-items: baseline; gap: 8px; }
      #vslots figcaption .cap { flex: 1; min-width: 0; }
      #vsrc { margin-top: 8px; }

      .swrow { display: flex; gap: 5px; flex-wrap: wrap; margin: 4px 0 8px; }
      .preset {
        padding: 1px 8px; font: inherit; font-size: 14px;
        background: #efe9d8; border: 2px solid var(--border); color: #1a1503;
        box-shadow: 2px 2px 0 var(--shadow);
      }
      .preset:active { transform: translate(1px, 1px); box-shadow: none; }
      .preset.on { background: var(--border); color: var(--yb); }
      .cfgrow { display: flex; align-items: center; gap: 7px; margin: 6px 0 8px; }
      .cfgrow input[type='checkbox'] { accent-color: var(--cable); width: 14px; height: 14px; }
      .cfgrow .saglbl { margin-left: 8px; }
      .cfgrow input[type='range'] { flex: 1; min-width: 60px; accent-color: var(--cable); }
      #sagval { min-width: 3em; text-align: right; }
      .btnrow { gap: 6px; margin-bottom: 4px; }
      .tinybtn.on { background: var(--border); color: var(--yb); }
      .swatch { width: 17px; height: 17px; padding: 0; border: 2px solid #000; }
      .swatch:hover, .swatch.on { outline: 2px solid #fff; }

      #zoomctl {
        position: fixed; right: 16px; bottom: 16px; z-index: 100;
        /* gleiche breite wie das you-fenster darüber — bündige spalte */
        width: 192px; justify-content: space-between;
        display: flex; gap: 6px; align-items: center;
        background: var(--tb); border: 2px solid var(--border);
        box-shadow: inset 0 2px 0 var(--tb-hi), inset 0 -2px 0 var(--tb-lo), 4px 4px 0 rgba(0, 0, 0, 0.45);
        padding: 5px 8px;
      }
      #zoomctl button {
        padding: 0 9px; background: var(--tb); border: 2px solid;
        border-color: var(--tb-hi) var(--tb-lo) var(--tb-lo) var(--tb-hi);
      }
      #zoomctl button:active { border-color: var(--tb-lo) var(--tb-hi) var(--tb-hi) var(--tb-lo); }
      /* fit DAUERHAFT rot im generate-look — doppelte id-spezifität nötig,
         sonst gewinnt die graue #zoomctl-button-regel den background */
      #zoomctl #zoomfit { background: #c81111; color: #ffe94d; border-color: #e8564e #7c0909 #7c0909 #e8564e; }
      #zoomctl #zoomfit:hover { background: #a80e0e; }
      #zoomctl #zoomfit:active { border-color: #7c0909 #e8564e #e8564e #7c0909; }
      #zoomlvl { min-width: 44px; text-align: center; font-size: 15px; color: #1a1a1a; }

      #lb { border: none; background: transparent; padding: 0; width: 100%; height: 100%; max-width: 100vw; max-height: 100dvh; }
      #lb::backdrop { background: rgba(7, 28, 74, 0.94); }
      .lbframe { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 24px; }
      #lb img { max-width: min(1400px, 94vw); max-height: 82dvh; border: 2px solid var(--border); box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.5); background: #efe9d8; }
      .lbbar { color: var(--yb); display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap; justify-content: center; }
      .lbbar button { background: transparent; border: 2px solid var(--yb); color: var(--yb); padding: 1px 8px; }
      .lbbar button:hover { background: #1233c8; }

      @media (max-width: 1100px) {
        /* topbar: zweizeilig (titel + links) statt abgeschnitten; scrollt mit */
        #topbar { position: static; height: auto; flex-wrap: wrap; padding: 8px 12px; gap: 6px 10px; white-space: normal; }
        #topbar .tb-title { width: 100%; font-size: 20px; }
        #topbar .sp, #helpbtn, #helpwin { display: none !important; }
        #win-teaser, #trashicon, #win-trash { display: none !important; }
        /* viewer-leiste: slider mobil ausblenden (mehrspaltig ist auf dem
           handy sinnlos) — übrig bleibt stabil "prev · seite · next" */
        .slotlbl, #slots, #slotcount, .vbar .sp { display: none !important; }
        #vp { position: static; overflow: visible; height: auto; cursor: default; touch-action: auto; }
        /* mobile: aufs wesentliche — viewer zuerst, dann generate.exe,
           dann das root-fenster, danach der rest in gewohnter reihenfolge */
        #canvas { position: static; width: auto; height: auto; transform: none !important; padding: 12px; display: flex; flex-direction: column; }
        .win { position: static !important; width: 100% !important; max-width: 560px; margin: 0 auto 18px; order: 10; }
        #win-viewer { order: 1; }
        #win-gen { order: 2; }
        #win-root { order: 3; }
        /* you-fenster: wird per js in den stapel gehängt, direkt nach root */
        #charwin {
          position: static; order: 4; width: 100%; max-width: 560px;
          margin: 0 auto 18px;
        }
        #charimg { max-width: 192px; }
        .win::before, .win::after, #cables, #zoomctl, .grip { display: none !important; }
        html, body { overscroll-behavior: auto; }
      }
    </style>

    <script>
      const $ = (id) => document.getElementById(id);
      const DATA = JSON.parse($('works-data').textContent);
      const vp = $('vp'), canvas = $('canvas'), cablesEl = $('cables');
      const isWide = () => window.matchMedia('(min-width: 1101px)').matches;

      // ---------- devmode: unveröffentlichtes nur für den artist ----------
      // /?dev einschalten · /?dev=off ausschalten — der zustand bleibt im
      // browser gespeichert, bis er explizit ausgeschaltet wird
      const devq = new URLSearchParams(location.search);
      if (devq.has('dev')) {
        if (devq.get('dev') === 'off') localStorage.removeItem('mpwDev');
        else localStorage.setItem('mpwDev', '1');
      }
      if (localStorage.getItem('mpwDev'))
        document.querySelectorAll('.devonly').forEach((el) => el.classList.remove('hidden'));

      // ---------- prefs (farben + offene fenster) ----------
      const PREFS_KEY = 'canvasPrefs';
      const prefs = JSON.parse(localStorage.getItem(PREFS_KEY) || '{}');
      const savePrefs = () => localStorage.setItem(PREFS_KEY, JSON.stringify(prefs));

      // ---------- pan & zoom ----------
      let z = 1, px = 0, py = 0;
      const apply = () => {
        canvas.style.transform = `translate(${px}px, ${py}px) scale(${z})`;
        $('zoomlvl').textContent = Math.round(z * 100) + '%';
        // raster mitführen; bei starkem rauszoomen abstand verdoppeln statt moiré
        let gs = 7 * z;
        while (gs < 5) gs *= 2;
        vp.style.backgroundSize = `${gs}px ${gs}px`;
        vp.style.backgroundPosition = `${px}px ${py}px`;
      };
      const setZoom = (nz, cx, cy) => {
        nz = Math.min(1.6, Math.max(0.2, nz));
        if (cx !== undefined) {
          px = cx - ((cx - px) / z) * nz;
          py = cy - ((cy - py) / z) * nz;
        }
        z = nz;
        apply();
      };
      // "fit" = exakt die start-kamera: 98%-zoom (auf schmaleren bildschirmen
      // automatisch kleiner, bis die volle breite reinpasst), horizontal
      // zentriert, oben bündig. fenster, die unten rausragen (info, tiefe
      // jahresstapel), werden bewusst ignoriert — nur minX/maxX/minY zählen
      const fit = () => {
        const wins = [...document.querySelectorAll('.win')].filter(
          (w) => !w.classList.contains('hidden') && w.id !== 'win-info' && w.id !== 'win-teaser'
        );
        if (!wins.length) return;
        const minX = Math.min(...wins.map((w) => w.offsetLeft));
        const minY = Math.min(...wins.map((w) => w.offsetTop));
        const maxX = Math.max(...wins.map((w) => w.offsetLeft + w.offsetWidth));
        const r = vp.getBoundingClientRect();
        z = Math.min(0.98, Math.max(0.45, (r.width - 80) / (maxX - minX)));
        const cw = (maxX - minX) * z;
        px = Math.max((r.width - cw) / 2 - minX * z, 40 - minX * z);
        py = -(minY - 40) * z;
        apply();
      };
      $('zoomin').onclick = () => setZoom(z * 1.15);
      $('zoomout').onclick = () => setZoom(z / 1.15);
      $('zoomfit').onclick = fit;
      vp.addEventListener('wheel', (e) => {
        if (!isWide()) return;
        e.preventDefault();
        const r = vp.getBoundingClientRect();
        setZoom(z * (e.deltaY < 0 ? 1.1 : 1 / 1.1), e.clientX - r.left, e.clientY - r.top);
      }, { passive: false });

      // pan / fenster-drag / resize — mit drag-schwelle: erst ab ein paar
      // pixeln bewegung gilt es als drag (klicks mit zittern bewegen nichts),
      // und nach einem echten drag wird der anschliessende click geschluckt
      const DRAG_MIN = 4;
      let mode = null, armed = null, sx = 0, sy = 0, dragWin = null, ox = 0, oy = 0, startW = 0;
      let downX = 0, downY = 0, dragged = false;
      vp.addEventListener('pointerdown', (e) => {
        if (!isWide()) return;
        // buttons in titelleisten (z. b. das popup-X) nie als drag armen —
        // pointer capture würde sonst deren click schlucken
        if (e.target.closest('.win-title button')) return;
        const grip = e.target.closest('.grip');
        const icon = e.target.closest('#trashicon');
        const title = icon || e.target.closest('.win-title');
        if (prefs.lock && (grip || title)) return;
        dragged = false;
        if (grip) {
          armed = 'resize';
          dragWin = grip.closest('.win');
          startW = dragWin.offsetWidth;
          sx = e.clientX;
        } else if (title) {
          armed = 'win';
          dragWin = icon || title.closest('.win');
          ox = (e.clientX - px) / z - dragWin.offsetLeft;
          oy = (e.clientY - py) / z - dragWin.offsetTop;
        } else if (e.target === vp || e.target === canvas || e.target === cablesEl) {
          armed = 'pan';
          sx = e.clientX - px;
          sy = e.clientY - py;
        } else return;
        downX = e.clientX;
        downY = e.clientY;
        // fürs desktop-icon kein pointer capture — es würde den click
        // (öffnen des trash-fensters) auf vp umleiten und schlucken
        if (!icon) vp.setPointerCapture(e.pointerId);
      });
      vp.addEventListener('pointermove', (e) => {
        if (armed && !mode) {
          if (Math.hypot(e.clientX - downX, e.clientY - downY) < DRAG_MIN) return;
          mode = armed;
          armed = null;
          dragged = true;
          if (mode === 'pan') vp.classList.add('panning');
        }
        if (mode === 'pan') {
          px = e.clientX - sx;
          py = e.clientY - sy;
          apply();
        } else if (mode === 'win') {
          dragWin.style.left = Math.max(-340, (e.clientX - px) / z - ox) + 'px';
          dragWin.style.top = Math.max(0, (e.clientY - py) / z - oy) + 'px';
          drawCables();
        } else if (mode === 'resize') {
          const w = Math.min(1700, Math.max(320, startW + (e.clientX - sx) / z));
          dragWin.style.width = w + 'px';
          drawCables();
        }
      });
      vp.addEventListener('pointerup', () => {
        mode = null;
        armed = null;
        dragWin = null;
        vp.classList.remove('panning');
      });
      // click nach echtem drag unterdrücken (capture, bevor buttons ihn sehen)
      vp.addEventListener('click', (e) => {
        if (dragged) {
          e.stopPropagation();
          e.preventDefault();
          dragged = false;
        }
      }, true);

      // ---------- fenster an/aus über das root-fenster ----------
      const openState = prefs.open || { 'win-2026': true, 'win-activity': true, 'win-gen': true };
      // neue standard-fenster für bestehende gespeicherte zustände nachrüsten
      if (!('win-activity' in openState)) openState['win-activity'] = true;
      if (!('win-gen' in openState)) openState['win-gen'] = true;
      // die 510er-spalte ist dynamisch: ist cull.exe offen, schieben sich
      // die jahresfenster (und der character-creator) um dessen höhe nach
      // unten — zu, und 2026 steht wieder ganz oben
      function layoutColumn() {
        const cull = $('win-cull');
        const off = cull && !cull.classList.contains('hidden') ? cull.offsetHeight + 50 : 0;
        document.querySelectorAll('[data-basetop]').forEach((w) => {
          w.style.top = Number(w.dataset.basetop) + off + 'px';
        });
      }
      function applyOpen() {
        document.querySelectorAll('.togglable').forEach((w) =>
          w.classList.toggle('hidden', !openState[w.id])
        );
        layoutColumn();
        document.querySelectorAll('.trow[data-win]').forEach((b) => {
          const on = !!openState[b.dataset.win];
          b.querySelector('.ind').textContent = on ? '[x]' : '[ ]';
          b.classList.toggle('on', on);
        });
        prefs.open = openState;
        savePrefs();
        if (openState['win-book']) loadBook();
        drawCables();
      }

      // ---------- residents.log: gästebuch aller charaktere ----------
      // lädt beim ersten öffnen des fensters; namen sind user-input und
      // werden escaped, bevor sie ins dom gehen
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      let bookLoaded = false;
      async function loadBook() {
        if (bookLoaded) return;
        bookLoaded = true;
        const box = $('win-book');
        const reg = box.dataset.reg;
        if (!reg) { $('bookline').textContent = 'local mode — no shared registry.'; return; }
        try {
          const j = await (await fetch(reg + '/book')).json();
          if (!j.residents || !j.residents.length) {
            $('bookline').textContent = 'no residents yet. the first one matters.';
            return;
          }
          $('bookline').textContent = `${j.residents.length} resident${j.residents.length === 1 ? '' : 's'} · newest first`;
          const BSTATS = ['literacy', 'bandwidth', 'provenance', 'friction', 'patience'];
          $('bookscroll').innerHTML = j.residents.map((c) => {
            const hasStats = c.stats && BSTATS.every((s) => s in c.stats);
            const detail = `
              <div class="small">${esc(c.klass || 'class unrecorded')}</div>
              ${hasStats
                ? BSTATS.map((s) => `<div class="csrow"><span>${s}</span><span class="csbar">${'▮'.repeat(c.stats[s])}${'▯'.repeat(5 - c.stats[s])}</span></div>`).join('')
                : '<div class="small dim">stats unrecorded</div>'}
              <div class="small dim bkmeta">sprite #${esc(c.sprite)} / 266 · gen ${Number(c.gen)} · ${esc(String(c.created).slice(0, 10))}</div>`;
            return `
              <button class="bkrow" type="button">
                <img class="gen-${((Number(c.gen) - 1) % 4) + 1}" src="${box.dataset.spritebase}${esc(c.sprite)}.webp" alt="" loading="lazy" width="36" height="36" />
                <span class="bkname">${esc(c.name)}</span>
                <span class="small dim bknum">#${Number(c.num)}</span>
              </button>
              <div class="bkdetail hidden">${detail}</div>`;
          }).join('');
          drawCables();
        } catch {
          bookLoaded = false;
          $('bookline').textContent = 'registry unreachable — try again later.';
        }
      }
      // profil auf-/zuklappen — immer nur eines offen, bleibt ruhig
      $('bookscroll').addEventListener('click', (e) => {
        const row = e.target.closest('.bkrow');
        if (!row) return;
        const det = row.nextElementSibling;
        const wasOpen = !det.classList.contains('hidden');
        document.querySelectorAll('.bkdetail').forEach((d) => d.classList.add('hidden'));
        document.querySelectorAll('.bkrow.open').forEach((r) => r.classList.remove('open'));
        if (!wasOpen) {
          det.classList.remove('hidden');
          row.classList.add('open');
        }
      });
      document.querySelectorAll('.trow[data-win]').forEach((b) =>
        b.addEventListener('click', () => {
          openState[b.dataset.win] = !openState[b.dataset.win];
          applyOpen();
        })
      );

      // ---------- kabel: comfyui-style mit durchhang ----------
      const PAIRS = [
        ['win-root', 'win-2022'], ['win-root', 'win-2023'], ['win-root', 'win-2024'],
        ['win-root', 'win-2025'], ['win-root', 'win-2026'],
        ['win-2022', 'win-viewer'], ['win-2023', 'win-viewer'], ['win-2024', 'win-viewer'],
        ['win-2025', 'win-viewer'], ['win-2026', 'win-viewer'],
        ['win-root', 'win-cc'], ['win-viewer', 'win-settings'],
        ['win-root', 'win-cull'], ['win-cull', 'win-viewer'],
        ['win-cull', 'win-kept'],
        ['win-root', 'win-about', 'left'], ['win-root', 'win-info', 'left'],
        ['win-root', 'win-gen'], ['win-gen', 'win-viewer'],
        ['win-root', 'win-store'], ['win-store', 'win-info'],
        ['win-root', 'win-report'],
        ['win-viewer', 'win-activity'],
        ['win-root', 'win-book'],
      ];
      const CABLE_SETS = {
        __rainbow: ['#e0473b', '#e8791c', '#ffe94d', '#57c94f', '#4a90d9', '#c77dff', '#ff6ad5'],
        __mix: ['#e0473b', '#e8c84d', '#57c94f', '#4a90d9'],
        __neon: ['#ff6ad5', '#5ad0e0', '#c77dff', '#8dff5a'],
        __chrome: ['#d8dbe2', '#9aa3b0', '#6b7280', '#c0c6d0'],
      };
      const sagF = () => (prefs.sag ?? 100) / 100;
      function drawCables() {
        if (!isWide()) { cablesEl.innerHTML = ''; return; }
        const raw = prefs.cable || '';
        const mixSet = CABLE_SETS[raw] || null;
        const single = mixSet
          ? null
          : raw || getComputedStyle(document.documentElement).getPropertyValue('--cable').trim();
        let html = '', ci = 0;
        for (const [ai, bi, mode] of PAIRS) {
          const A = $(ai), B = $(bi);
          if (!A || !B) continue;
          if (A.classList.contains('hidden') || B.classList.contains('hidden')) continue;
          const color = mixSet ? mixSet[ci++ % mixSet.length] : single;
          let d, x1, y1, x2, y2;
          if (mode === 'left') {
            // andersherum: links raus in den freien raum. das kabel fällt
            // steil aus dem oberen port (kontrollpunkt weit unten), schwingt
            // links aussen vorbei und läuft horizontal in den zielport ein.
            // beide kontrollpunkte liegen links der ports — die kurve bleibt
            // damit immer im leeren bereich, nie hinter fenstern
            x1 = A.offsetLeft; y1 = A.offsetTop + 22;
            x2 = B.offsetLeft; y2 = B.offsetTop + 22;
            const dist = Math.hypot(x2 - x1, y2 - y1);
            const bulge = Math.min(70 + dist * 0.18, 180);
            const sag = Math.min(dist * 0.5, 380) * sagF();
            d = `M${x1} ${y1} C${x1 - bulge} ${y1 + sag}, ${x2 - bulge} ${y2}, ${x2} ${y2}`;
          } else {
            const leftFirst = A.offsetLeft + A.offsetWidth / 2 <= B.offsetLeft + B.offsetWidth / 2;
            x1 = leftFirst ? A.offsetLeft + A.offsetWidth : A.offsetLeft;
            y1 = A.offsetTop + 22;
            x2 = leftFirst ? B.offsetLeft : B.offsetLeft + B.offsetWidth;
            y2 = B.offsetTop + 22;
            const dx = x2 - x1, dir = dx >= 0 ? 1 : -1;
            const dist = Math.hypot(dx, y2 - y1);
            // kurze kabel: kein durchhang -> glatte s-kurve statt gestauchter welle;
            // erst ab ~180px distanz beginnt das kabel durchzuhängen
            const sag = Math.min(Math.max(0, dist - 180) * 0.42, 320) * sagF();
            const hoff = Math.min(Math.abs(dx) * 0.42 + 26, 175);
            d = `M${x1} ${y1} C${x1 + hoff * dir} ${y1 + sag}, ${x2 - hoff * dir} ${y2 + sag}, ${x2} ${y2}`;
          }
          html +=
            `<path d="${d}" fill="none" stroke="rgba(0,0,0,0.45)" stroke-width="5"/>` +
            `<path d="${d}" fill="none" stroke="${color}" stroke-width="3"/>` +
            `<circle cx="${x1}" cy="${y1}" r="5" fill="${color}" stroke="rgba(0,0,0,0.45)"/>` +
            `<circle cx="${x2}" cy="${y2}" r="5" fill="${color}" stroke="rgba(0,0,0,0.45)"/>`;
        }
        cablesEl.setAttribute('viewBox', `0 0 ${canvas.offsetWidth} ${canvas.offsetHeight}`);
        cablesEl.innerHTML = html;
        // teaser-pfeil: spiegeln, sobald das fenster rechts vom portfolio hängt
        const tw = $('win-teaser'), gw = $('win-root');
        if (tw && gw) {
          tw.classList.toggle('flip', tw.offsetLeft + tw.offsetWidth / 2 > gw.offsetLeft + gw.offsetWidth / 2);
        }
      }

      // ---------- likes: zähler auf dem worker, eigene likes im browser ----------
      const LIKEREG = $('win-book')?.dataset.reg || '';
      let likeCounts = {};
      const myLikes = JSON.parse(localStorage.getItem('mpwLikes') || '{}');
      const likeLabel = (slug) => '♥' + (likeCounts[slug] ? ' ' + likeCounts[slug] : '');
      function toggleLike(slug) {
        const on = !myLikes[slug];
        if (on) myLikes[slug] = true; else delete myLikes[slug];
        likeCounts[slug] = Math.max(0, (likeCounts[slug] || 0) + (on ? 1 : -1));
        localStorage.setItem('mpwLikes', JSON.stringify(myLikes));
        if (LIKEREG)
          fetch(LIKEREG + '/like', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ slug, on }),
          }).catch(() => {});
      }
      if (LIKEREG)
        fetch(LIKEREG + '/likes')
          .then((r) => r.json())
          .then((j) => { likeCounts = j.likes || {}; renderViewer(); })
          .catch(() => {});

      // ---------- viewer ----------
      // start: das aktuelle jahr (2026) komplett, nicht die selected works
      let selection = DATA.byYear['2026'] || DATA.featured, srcLabel = '2026', page = 0, slots = 1;
      // guest mode: viewer locked auf 1 window + fenster skaliert aufs bild;
      // beim verlassen werden slots und fensterbreite wiederhergestellt
      let savedSlots = 0, savedViewerW = null;
      function renderViewer() {
        const el = $('vslots');
        // alte höhe festhalten, bis die neuen bilder geladen sind — sonst
        // kollabiert das fenster für einen frame und alles springt
        if (el.offsetHeight) el.style.minHeight = el.offsetHeight + 'px';
        const g = srcLabel === 'guest';
        $('win-viewer').classList.toggle('guest', g);
        $('slots').disabled = g;
        if (g) {
          if (savedSlots === 0) savedSlots = slots;
          slots = 1;
          $('slots').value = 1;
          if (savedViewerW === null) savedViewerW = $('win-viewer').style.width || '960px';
        } else {
          if (savedSlots) { slots = savedSlots; savedSlots = 0; $('slots').value = slots; }
          if (savedViewerW !== null) { $('win-viewer').style.width = savedViewerW; savedViewerW = null; }
        }
        el.dataset.slots = slots;
        const pages = Math.max(1, Math.ceil(selection.length / slots));
        page = Math.min(page, pages - 1);
        const chunk = selection.slice(page * slots, page * slots + slots);
        el.innerHTML = chunk
          .map(
            (w, i) => `<figure>
              <img src="${slots === 1 ? w.image : w.thumb}" alt="${w.title}" loading="lazy" data-idx="${page * slots + i}" />
              <figcaption><span class="cap">${w.title} <span class="dim">— ${w.year}${w.note ? ' · ' + w.note : ''}</span></span>${w.guest ? '' : `<button class="likebtn${myLikes[w.slug] ? ' on' : ''}" data-like="${w.slug}" title="like">${likeLabel(w.slug)}</button>`}</figcaption>
            </figure>`
          )
          .join('');
        $('vpage').textContent = `${page + 1}/${pages}`;
        $('guesthint').classList.toggle('hidden', srcLabel !== 'guest');
        $('vsrc').textContent = `source: ${srcLabel} · ${selection.length} ${selection.length === 1 ? 'work' : 'works'}`;
        $('slotcount').textContent = slots;
        document.querySelectorAll('.loadbtn').forEach((b) =>
          b.classList.toggle('on', b.dataset.load === srcLabel || (srcLabel === 'selected-works' && b.dataset.load === 'featured'))
        );
        // min-height erst lösen, wenn alle neuen bilder geladen sind
        const imgs = [...el.querySelectorAll('img')];
        // guest: fensterbreite = bildbreite 1:1 (plus rahmen), links oben fix
        if (g && imgs[0]) {
          const sizeToImg = () => {
            const nw = imgs[0].naturalWidth;
            if (nw) {
              $('win-viewer').style.width = Math.min(1700, Math.max(320, nw + 32)) + 'px';
              drawCables();
            }
          };
          if (imgs[0].complete) sizeToImg();
          else imgs[0].addEventListener('load', sizeToImg, { once: true });
        }
        let pending = imgs.filter((im) => !im.complete).length;
        const release = () => {
          el.style.minHeight = '';
          drawCables();
        };
        if (!pending) release();
        else imgs.forEach((im) => {
          if (!im.complete) im.addEventListener('load', () => { if (--pending <= 0) release(); }, { once: true });
          if (!im.complete) im.addEventListener('error', () => { if (--pending <= 0) release(); }, { once: true });
        });
        drawCables();
      }
      $('slots').addEventListener('input', (e) => {
        slots = Number(e.target.value);
        renderViewer();
      });
      $('vprev').onclick = () => { page = Math.max(0, page - 1); renderViewer(); };
      $('vnext').onclick = () => { page++; renderViewer(); };
      // animationen: einzeln in den viewer laden
      document.querySelectorAll('.animrow').forEach((b) =>
        b.addEventListener('click', () => {
          const a = DATA.animations.find((x) => x.slug === b.dataset.anim);
          if (!a) return;
          selection = [a];
          srcLabel = `animation: ${a.title}`;
          page = 0;
          renderViewer();
        })
      );
      document.querySelectorAll('.loadbtn').forEach((b) =>
        b.addEventListener('click', () => {
          const k = b.dataset.load;
          if (k === 'featured') { selection = DATA.featured; srcLabel = 'selected-works'; }
          else if (k === 'all') { selection = DATA.all; srcLabel = 'all'; }
          else { selection = DATA.byYear[k] || []; srcLabel = k; }
          page = 0;
          renderViewer();
        })
      );

      // ---------- lightbox ----------
      const lb = $('lb'), lbimg = lb.querySelector('img');
      let lbIdx = 0;
      const showLb = (i) => {
        lbIdx = (i + selection.length) % selection.length;
        const w = selection[lbIdx];
        lbimg.src = w.image;
        lbimg.alt = w.title;
        $('lbtitle').textContent = `${w.title} — ${w.year}${w.note ? ' · ' + w.note : ''}`;
        $('lblike').textContent = likeLabel(w.slug);
        $('lblike').classList.toggle('on', !!myLikes[w.slug]);
        $('lblike').style.display = w.guest ? 'none' : '';
        // permalink: url zeigt aufs aktuelle werk (nicht für gast-bilder)
        if (!w.guest) history.replaceState(null, '', '#' + w.slug);
        if (!lb.open) lb.showModal();
      };
      lb.addEventListener('close', () => history.replaceState(null, '', location.pathname + location.search));
      $('vslots').addEventListener('click', (e) => {
        const lk = e.target.closest('[data-like]');
        if (lk) {
          toggleLike(lk.dataset.like);
          lk.classList.toggle('on');
          lk.textContent = likeLabel(lk.dataset.like);
          return;
        }
        if (e.target.dataset.idx !== undefined) showLb(Number(e.target.dataset.idx));
      });
      lb.querySelectorAll('[data-nav]').forEach((b) => (b.onclick = () => showLb(lbIdx + Number(b.dataset.nav))));
      $('lbrnd').onclick = () => {
        if (selection.length < 2) return;
        let ni;
        do { ni = Math.floor(Math.random() * selection.length); } while (ni === lbIdx);
        showLb(ni);
      };
      $('lblike').onclick = () => {
        const w = selection[lbIdx];
        if (!w) return;
        toggleLike(w.slug);
        $('lblike').textContent = likeLabel(w.slug);
        $('lblike').classList.toggle('on', !!myLikes[w.slug]);
        renderViewer();
      };
      $('lbclose').onclick = () => lb.close();
      lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
      lb.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') showLb(lbIdx - 1);
        if (e.key === 'ArrowRight') showLb(lbIdx + 1);
      });
      // pfeiltasten blättern auch ohne vollbild — ausser in eingabefeldern.
      // im gast-modus (cull.exe): p/k = behalten, x = raus — wie beim culling
      document.addEventListener('keydown', (e) => {
        const t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA')) return;
        const k = e.key.toLowerCase();
        if (srcLabel === 'guest' && (k === 'p' || k === 'k' || k === 'x')) {
          cullMark(k === 'x' ? 'drop' : 'keep');
          return;
        }
        if (lb.open) return;
        if (e.key === 'ArrowLeft') { page = Math.max(0, page - 1); renderViewer(); }
        else if (e.key === 'ArrowRight') { page++; renderViewer(); }
      });

      // ---------- generate.exe: der einzige generator, der nur findet ----------
      const GEN_FRAMES = ['░', '▒', '▓', '█'];
      let genBusy = false;
      $('genbtn').addEventListener('click', () => {
        if (genBusy) return;
        genBusy = true;
        const btn = $('genbtn'), log = $('genlog');
        btn.disabled = true;
        btn.classList.add('flash');
        setTimeout(() => btn.classList.remove('flash'), 140);
        const steps = [
          'loading checkpoint..............',
          'encoding prompt.................',
          'sampling latents................',
          'denoising (step %/12)...........',
          'decoding to pixel space.........',
        ];
        let t = 0;
        const total = 12;
        const iv = setInterval(() => {
          t++;
          const pct = Math.min(100, Math.round((t / total) * 100));
          const barLen = 18;
          const fill = Math.round((pct / 100) * barLen);
          const bar = '█'.repeat(fill) + '░'.repeat(barLen - fill);
          const step = steps[Math.min(steps.length - 1, Math.floor((t / total) * steps.length))].replace('%', String(t));
          log.textContent = `${step}\n[${bar}] ${pct}% ${GEN_FRAMES[t % GEN_FRAMES.length]}`;
          if (t >= total) {
            clearInterval(iv);
            // ergebnis landet nur im viewer — und zieht nur aus dem, was
            // gerade geladen ist (2026 beim start, sonst die aktive auswahl)
            if (!selection.length) {
              log.textContent = 'nothing loaded. pick a year first.';
            } else {
              // guest mode kann generate auf "ein bild weiter" umschalten
              const idx = srcLabel === 'guest' && cullGenNext
                ? (page * slots + 1) % selection.length
                : Math.floor(Math.random() * selection.length);
              const w = selection[idx];
              log.textContent = `done. seed: ${Math.floor(Math.random() * 4294967296)} → viewer\n(honestly: this was made in ${w.year}. the machine only remembers.)`;
              page = Math.floor(idx / slots);
              renderViewer();
            }
            btn.disabled = false;
            genBusy = false;
          }
        }, 45);
      });

      // ---------- archive activity: besucher der letzten 14 tage ----------
      // live-daten via goatcounter (cookielos), wenn in site.js ein code
      // konfiguriert ist — sonst klar gelabelter demo-modus.
      (async () => {
        const box = $('win-activity');
        if (!box) return;
        const gc = box.dataset.gc;
        const DAYS = 14;
        const dayKeys = [];
        for (let i = DAYS - 1; i >= 0; i--) {
          const d = new Date();
          d.setDate(d.getDate() - i);
          dayKeys.push(d.toISOString().slice(0, 10));
        }
        // goatcounters counter-endpoint: rate-limit (~4 req/s), daher
        // NACHEINANDER abfragen. und statt start=TAG&end=TAG (unklare
        // end-semantik, lieferte konstant 0) kumulativ "von tag X bis heute"
        // nur mit start — die tageswerte entstehen als differenz benachbarter
        // summen. fehlerantworten zählen nie als 0, sondern kippen in demo
        const fetchCount = async (qs) => {
          const r = await fetch(`https://${gc}.goatcounter.com/counter/TOTAL.json${qs}`);
          if (!r.ok) throw new Error('goatcounter http ' + r.status);
          const j = await r.json();
          return Number(String(j.count).replace(/\D/g, '')) || 0;
        };
        const fetchFrom = (day) => fetchCount(`?start=${day}`);
        let counts = null, live = false, total = 0;
        if (gc) {
          try {
            // gesamtzähler seit beginn (ohne zeitraum) — rückwirkend komplett
            total = await fetchCount('');
            await new Promise((res) => setTimeout(res, 300));
            const cums = [];
            for (const day of dayKeys) {
              cums.push(await fetchFrom(day));
              await new Promise((res) => setTimeout(res, 300));
            }
            // dayKeys ist ältester -> heute; diff = besuche genau an dem tag
            counts = cums.map((c, i) => Math.max(0, c - (cums[i + 1] ?? 0)));
            live = true;
          } catch { counts = null; }
        }
        if (!counts) {
          // demo-signal: deterministisch pro tag, damit es stabil aussieht
          counts = dayKeys.map((day) => {
            let h = 0;
            for (const c of day) h = (h * 31 + c.charCodeAt(0)) >>> 0;
            return 3 + (h % 34);
          });
        }
        // led-equalizer-optik: gestapelte segmente statt durchgehender balken
        const max = Math.max(...counts, 1);
        const bw = 16, gap = 4, H = 56, SEG = 5, SGAP = 2, MAXSEG = 8;
        let bars = `<line x1="0" y1="${H - 1}" x2="280" y2="${H - 1}" stroke="var(--border)" stroke-width="2"/>`;
        counts.forEach((c, i) => {
          const nseg = Math.max(1, Math.round((c / max) * MAXSEG));
          const today = i === counts.length - 1;
          for (let s = 0; s < nseg; s++) {
            const y = H - 3 - (s + 1) * SEG - s * SGAP;
            const top = s === nseg - 1;
            bars += `<rect x="${i * (bw + gap) + 1}" y="${y}" width="${bw}" height="${SEG}"
              fill="${today ? '#c81111' : top ? '#e8a01c' : '#ffe94d'}"/>`;
          }
        });
        $('actgraph').innerHTML = bars;
        const week = counts.slice(-7).reduce((a, b) => a + b, 0);
        $('actline').textContent = live
          ? `${total} visitors / all time`
          : `${week} visitors / last 7 days`;
        $('actsub').textContent = live
          ? `today: ${counts[counts.length - 1]} · via goatcounter, cookie-free`
          : gc
            ? 'demo signal — goatcounter counter api not reachable'
            : 'demo signal — set GOATCOUNTER in site.js for live data';
        if (live) {
          // heutigen balken alle 60s aktualisieren
          setInterval(async () => {
            try {
              const c = await fetchFrom(dayKeys[dayKeys.length - 1]);
              $('actsub').textContent = `today: ${c} · via goatcounter, cookie-free`;
            } catch {}
          }, 60000);
        }
      })();

      // ---------- charakter-fenster (aus dem creator, localStorage) ----------
      // existiert ein charakter: creator-fenster verschwindet, die
      // character-creator-zeile im root minimiert/öffnet stattdessen das side-menü
      (() => {
        const c = JSON.parse(localStorage.getItem('mpwCharacter') || 'null');
        if (!c) return;
        const box = $('charwin');
        // mobile: das fixe fenster in den gestapelten flow hängen (flex-order
        // platziert es nach dem root-fenster) — desktop bleibt fixed unten rechts
        if (!isWide()) $('canvas').appendChild(box);
        // stats minimal halten: klick aufs bild klappt sie auf/zu
        // (desktop zeigt sie zusätzlich bei hover)
        $('charimg').addEventListener('click', () => box.classList.toggle('exp'));
        $('charimg').src = box.dataset.spritebase + c.sprite + '.webp';
        if (c.gen) $('charimg').className = 'gen-' + (((c.gen - 1) % 4) + 1);
        $('charname').textContent = c.name;
        $('charclass').textContent = c.klass;
        $('charno').textContent = c.num
          ? `character #${c.num} · gen ${c.gen}`
          : `character #${c.sprite} / 266`;
        const CSTATS = ['literacy', 'bandwidth', 'provenance', 'friction', 'patience'];
        if (c.stats && CSTATS.every((s) => s in c.stats)) {
          $('charstats').innerHTML = CSTATS.map(
            (s) => `<div class="csrow"><span>${s}</span><span class="csbar">${'▮'.repeat(c.stats[s])}${'▯'.repeat(5 - c.stats[s])}</span></div>`
          ).join('');
        }

        // export: die character.txt ist jederzeit neu erzeugbar — gleiche
        // form wie beim erstellen, direkt aus dem lokalen speicher.
        // WICHTIG: format synchron halten mit persist() im character-creator
        const lines = [
          '== moepwellington.xyz — character file ==',
          '',
          'this file IS your character. keep it safe.',
          'to bring the character back (new browser, new device):',
          'moepwellington.xyz -> import character -> paste the',
          'ENTIRE contents of this file. that is all.',
          '',
          `name:      ${c.name}`,
          `class:     ${c.klass}`,
          `sprite:    #${c.sprite} / 266`,
          c.num ? `character: #${c.num} · generation ${c.gen}` : 'mode:      local',
          c.stats && CSTATS.every((s) => s in c.stats)
            ? `stats:     ${CSTATS.map((s) => `${s} ${c.stats[s]}`).join(' · ')}`
            : null,
          `created:   ${c.created}`,
          '',
          c.token
            ? `recovery token — the only proof this character is yours. do not share it:\n${c.token}`
            : 'no token — local character, lives in this browser only.',
        ].filter((l) => l !== null).join('\n');
        // baum-eintrag "save character.txt" aktivieren
        $('charsave-row').href = URL.createObjectURL(new Blob([lines], { type: 'text/plain' }));
        $('charsave-row').classList.remove('hidden');
        // creator-fenster dauerhaft aus; zeile im root wird zum toggle
        openState['win-cc'] = false;
        const ccRow = document.querySelector('.trow[data-win="win-cc"]');
        if (ccRow) {
          ccRow.removeAttribute('data-win'); // entkoppelt vom fenster-toggle
          const sync = () => {
            const open = prefs.charwin !== false;
            box.classList.toggle('hidden', !open);
            ccRow.querySelector('.ind').textContent = open ? '[x]' : '[ ]';
            ccRow.classList.toggle('on', open);
          };
          ccRow.addEventListener('click', () => {
            prefs.charwin = prefs.charwin === false;
            savePrefs();
            sync();
          });
          sync();
        } else {
          box.classList.remove('hidden');
        }
      })();

      // popup-werbung: X schliesst nur für diesen besuch — beim reload ist
      // sie wieder da. genau wie früher.
      $('teaserx').addEventListener('click', (e) => {
        e.preventDefault();
        $('win-teaser').classList.add('hidden');
      });

      // ---------- cull.exe: gast-kuration — alles bleibt im browser ----------
      // bilder werden NIE hochgeladen: objekt-urls direkt aus den lokalen
      // dateien, der viewer behandelt sie wie werke. p/k = keep, x = drop.
      let guest = [], keptOrder = [], guestSeq = 0;
      let cullGenNext = false;
      const guestWorks = () =>
        guest
          .filter((g) => g.status !== 'drop')
          .map((g, i) => ({
            slug: 'guest-' + i, guest: g, image: g.url, thumb: g.url,
            title: (g.status === 'keep' ? '✓ ' : '') + g.name, year: 'guest', note: '',
          }));
      function loadGuest() {
        selection = guestWorks();
        srcLabel = 'guest';
        page = 0;
        renderViewer();
      }
      async function cullLoad(files) {
        const imgs = [...files]
          .filter((f) => /^image\//.test(f.type))
          .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));
        if (!imgs.length) return;
        guest.forEach((g) => URL.revokeObjectURL(g.url));
        guest = imgs.map((f) => ({ file: f, name: f.name, url: URL.createObjectURL(f), status: '' }));
        keptOrder = [];
        guestSeq = 0;
        updateCull();
        loadGuest();
      }
      function cullMark(status) {
        if (!guest.length) return;
        const idx = lb.open ? lbIdx : Math.min(page * slots, selection.length - 1);
        const w = selection[idx];
        if (!w || !w.guest) return;
        const g = w.guest;
        g.status = status;
        if (status === 'keep') {
          if (!keptOrder.includes(g)) keptOrder.push(g);
        } else {
          keptOrder = keptOrder.filter((x) => x !== g);
        }
        const wasLb = lb.open;
        selection = guestWorks();
        if (!selection.length) {
          if (wasLb) lb.close();
          renderViewer();
          updateCull();
          return;
        }
        const ni = Math.min(status === 'drop' ? idx : idx + 1, selection.length - 1);
        page = Math.floor(ni / slots);
        renderViewer();
        if (wasLb) showLb(ni);
        updateCull();
      }
      function updateCull() {
        const has = guest.length > 0;
        $('cullempty').classList.toggle('hidden', has);
        $('cullstate').classList.toggle('hidden', !has);
        if (has) {
          const dropped = guest.filter((g) => g.status === 'drop').length;
          const open = guest.filter((g) => !g.status).length;
          $('cullthumbs').innerHTML = guest.slice(0, 3)
            .map((g) => `<img src="${g.url}" alt="" loading="lazy" width="64" height="64" />`).join('');
          $('cullline').textContent = `${guest.length} images · ${keptOrder.length} kept · ${dropped} dropped · ${open} open`;
          const stripHtml = keptOrder.length
            ? keptOrder.map((g, i) => `<img class="cullthumb" draggable="true" data-i="${i}" src="${g.url}" title="${esc(g.name)}" loading="lazy" />`).join('')
            : '<span class="small dim">nothing kept yet — press p in the viewer.</span>';
          $('cullstrip').innerHTML = stripHtml;
          $('keptgrid').innerHTML = stripHtml;
          $('keptline').textContent = keptOrder.length
            ? `${keptOrder.length} kept — drag to reorder. this is your collection order.`
            : 'nothing kept yet — press p in the viewer.';
          $('cullzip').disabled = cullExportAll
            ? guest.every((g) => g.status === 'drop')
            : !keptOrder.length;
        }
        updateTrash();
        layoutColumn();
        drawCables();
      }
      $('cullpick').onclick = () => $('cullinput').click();
      $('cullpick2').addEventListener('click', (e) => { e.preventDefault(); $('cullinput2').click(); });
      $('cullinput').addEventListener('change', (e) => cullLoad(e.target.files));
      $('cullinput2').addEventListener('change', (e) => cullLoad(e.target.files));
      $('win-cull').addEventListener('dragover', (e) => e.preventDefault());
      $('win-cull').addEventListener('drop', (e) => {
        e.preventDefault();
        if (e.dataTransfer?.files?.length) cullLoad(e.dataTransfer.files);
      });
      $('cullload').onclick = loadGuest;
      const syncCullGen = () => {
        $('cullgenrnd').classList.toggle('on', !cullGenNext);
        $('cullgennext').classList.toggle('on', cullGenNext);
      };
      $('cullgenrnd').onclick = () => { cullGenNext = false; syncCullGen(); };
      $('cullgennext').onclick = () => { cullGenNext = true; syncCullGen(); };
      syncCullGen();
      // export-modus: nur gepickte (p) — oder alles, was nicht gedroppt ist
      let cullExportAll = false;
      const syncCullEx = () => {
        $('cullexkept').classList.toggle('on', !cullExportAll);
        $('cullexall').classList.toggle('on', cullExportAll);
        $('cullexnote').textContent = cullExportAll
          ? 'exports everything you did not drop — picked first (your order), then the undecided.'
          : 'exports only picked (p) images, in your order.';
        updateCull();
      };
      $('cullexkept').onclick = () => { cullExportAll = false; syncCullEx(); };
      $('cullexall').onclick = () => { cullExportAll = true; syncCullEx(); };
      syncCullEx();
      $('cullmax').onclick = () => {
        $('win-kept').classList.toggle('hidden');
        drawCables();
      };
      // trash.bin: gedroppte bilder landen im mülleimer, klick restauriert
      function updateTrash() {
        const dropped = guest.filter((g) => g.status === 'drop');
        $('trashicon').classList.toggle('empty', !dropped.length);
        $('trashline').textContent = dropped.length
          ? `${dropped.length} in the bin — click to restore.`
          : 'empty.';
        $('trashgrid').innerHTML = dropped
          .map((g) => `<img src="${g.url}" data-n="${esc(g.name)}" title="restore ${esc(g.name)}" loading="lazy" />`)
          .join('');
        $('trashall').classList.toggle('hidden', !dropped.length);
      }
      $('trashicon').addEventListener('click', () => {
        $('win-trash').classList.toggle('hidden');
        drawCables();
      });
      $('trashgrid').addEventListener('click', (e) => {
        const im = e.target.closest('img');
        if (!im) return;
        const g = guest.find((x) => x.status === 'drop' && x.name === im.dataset.n);
        if (!g) return;
        g.status = '';
        if (srcLabel === 'guest') { selection = guestWorks(); renderViewer(); }
        updateCull();
      });
      $('trashall').onclick = () => {
        guest.forEach((g) => { if (g.status === 'drop') g.status = ''; });
        if (srcLabel === 'guest') loadGuest();
        updateCull();
      };
      $('cullclear').onclick = () => {
        guest.forEach((g) => URL.revokeObjectURL(g.url));
        guest = []; keptOrder = [];
        if (srcLabel === 'guest') {
          selection = DATA.byYear['2026'] || DATA.featured;
          srcLabel = '2026';
          page = 0;
          renderViewer();
        }
        updateCull();
      };
      // kept-reihenfolge per drag&drop — im strip und im kept-fenster
      let cullDragI = null;
      const bindReorder = (id) => {
        const el2 = $(id);
        el2.addEventListener('dragstart', (e) => {
          const t = e.target.closest('.cullthumb');
          if (t) cullDragI = Number(t.dataset.i);
        });
        el2.addEventListener('dragover', (e) => e.preventDefault());
        el2.addEventListener('drop', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const t = e.target.closest('.cullthumb');
          if (!t || cullDragI === null) return;
          const to = Number(t.dataset.i);
          const [m] = keptOrder.splice(cullDragI, 1);
          keptOrder.splice(to, 0, m);
          cullDragI = null;
          updateCull();
        });
      };
      bindReorder('cullstrip');
      bindReorder('keptgrid');
      // zip-export: store-only zip komplett im browser gebaut (kein server)
      let CRC_T;
      function crc32(u8) {
        if (!CRC_T) {
          CRC_T = new Int32Array(256);
          for (let n = 0; n < 256; n++) {
            let c = n;
            for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
            CRC_T[n] = c;
          }
        }
        let c = -1;
        for (let i = 0; i < u8.length; i++) c = CRC_T[(c ^ u8[i]) & 0xff] ^ (c >>> 8);
        return (c ^ -1) >>> 0;
      }
      async function buildZip(items) {
        const enc = new TextEncoder();
        const parts = [], central = [];
        let offset = 0;
        for (const it of items) {
          const data = new Uint8Array(await it.file.arrayBuffer());
          const nameB = enc.encode(it.name);
          const crc = crc32(data);
          const lh = new DataView(new ArrayBuffer(30));
          lh.setUint32(0, 0x04034b50, true);
          lh.setUint16(4, 20, true);
          lh.setUint16(6, 0x0800, true);
          lh.setUint32(14, crc, true);
          lh.setUint32(18, data.length, true);
          lh.setUint32(22, data.length, true);
          lh.setUint16(26, nameB.length, true);
          parts.push(lh.buffer, nameB, data);
          const ch = new DataView(new ArrayBuffer(46));
          ch.setUint32(0, 0x02014b50, true);
          ch.setUint16(4, 20, true);
          ch.setUint16(6, 20, true);
          ch.setUint16(8, 0x0800, true);
          ch.setUint32(16, crc, true);
          ch.setUint32(20, data.length, true);
          ch.setUint32(24, data.length, true);
          ch.setUint16(28, nameB.length, true);
          ch.setUint32(42, offset, true);
          central.push(ch.buffer, nameB);
          offset += 30 + nameB.length + data.length;
        }
        const cdSize = central.reduce((a, b) => a + b.byteLength, 0);
        const eocd = new DataView(new ArrayBuffer(22));
        eocd.setUint32(0, 0x06054b50, true);
        eocd.setUint16(8, items.length, true);
        eocd.setUint16(10, items.length, true);
        eocd.setUint32(12, cdSize, true);
        eocd.setUint32(16, offset, true);
        return new Blob([...parts, ...central, eocd.buffer], { type: 'application/zip' });
      }
      $('cullzip').addEventListener('click', async () => {
        const list = cullExportAll
          ? [...keptOrder, ...guest.filter((g) => !g.status)]
          : keptOrder;
        if (!list.length) return;
        $('cullzip').textContent = 'packing…';
        $('cullzip').disabled = true;
        try {
          const chr = JSON.parse(localStorage.getItem('mpwCharacter') || 'null');
          const txt = [
            '== moepwellington.xyz — guest collection ==',
            '',
            `curated with cull.exe · ${new Date().toISOString().slice(0, 10)}`,
            chr ? `curated by ${chr.name}${chr.klass ? ' — ' + chr.klass : ''}` : 'curated by an unnamed visitor',
            `${list.length} works (${cullExportAll ? 'everything not dropped' : 'picked only'}), in order:`,
            ...list.map((g, i) => `${String(i + 1).padStart(3, '0')}  ${g.name}`),
            '',
            'your images never left your browser.',
          ].join('\n');
          const items = list.map((g, i) => ({
            name: String(i + 1).padStart(3, '0') + '_' + g.name.replace(/[\\/]/g, '_'),
            file: g.file,
          }));
          items.push({ name: 'collection.txt', file: new Blob([txt]) });
          const blob = await buildZip(items);
          const a = document.createElement('a');
          a.href = URL.createObjectURL(blob);
          a.download = 'collection.zip';
          a.click();
          setTimeout(() => URL.revokeObjectURL(a.href), 30000);
        } finally {
          $('cullzip').textContent = 'export zip →';
          $('cullzip').disabled = false;
        }
      });

      // ---------- feedback.exe ----------
      $('fbsend').addEventListener('click', async () => {
        const reg = $('win-report').dataset.reg;
        const text = $('fbtext').value.trim();
        if (text.length < 3) { $('fbstatus').textContent = 'say a little more.'; return; }
        if (!reg) { $('fbstatus').textContent = 'local mode — nowhere to send.'; return; }
        $('fbsend').disabled = true;
        $('fbstatus').textContent = 'sending…';
        try {
          const r = await fetch(reg + '/feedback', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ text, url: location.pathname, website: $('fbhp').value }),
          });
          if (r.ok) { $('fbtext').value = ''; $('fbstatus').textContent = 'received. the archive remembers.'; }
          else if (r.status === 429) $('fbstatus').textContent = 'easy — wait a few seconds.';
          else $('fbstatus').textContent = 'refused. try again.';
        } catch { $('fbstatus').textContent = 'unreachable. try again later.'; }
        $('fbsend').disabled = false;
      });

      // ---------- hilfe ----------
      $('helpbtn').onclick = () => {
        $('helpwin').classList.toggle('hidden');
        $('helpbtn').classList.toggle('on');
      };

      // ---------- farben: canvas / fenster / kabel einzeln ----------
      function applyPrefs() {
        const root = document.documentElement.style;
        prefs.bg ? root.setProperty('--bg', prefs.bg) : root.removeProperty('--bg');
        const cableCss = CABLE_SETS[prefs.cable] ? CABLE_SETS[prefs.cable][0] : prefs.cable;
        cableCss ? root.setProperty('--cable', cableCss) : root.removeProperty('--cable');
        if (prefs.win === '__mix') {
          root.setProperty('--win', '#d9cd4e');
          root.setProperty('--win-alt', '#e9e4cf');
        } else if (prefs.win) {
          root.setProperty('--win', prefs.win);
          root.setProperty('--win-alt', prefs.win);
        } else {
          root.removeProperty('--win');
          root.removeProperty('--win-alt');
        }
        for (const [rowId, key] of [['bgswatches', 'bg'], ['winswatches', 'win'], ['cableswatches', 'cable']]) {
          $(rowId).querySelectorAll('.swatch').forEach((s) => s.classList.toggle('on', (prefs[key] || '') === s.dataset.v));
        }
        // grid + sag controls synchron halten
        vp.style.backgroundImage = prefs.grid === false ? 'none' : '';
        $('gridtoggle').checked = prefs.grid !== false;
        $('sagslider').value = prefs.sag ?? 100;
        $('sagval').textContent = (prefs.sag ?? 100) + '%';
        // preset-markierung: exakt passende kombination hervorheben
        document.querySelectorAll('.preset').forEach((b) => {
          const p = PRESETS[b.dataset.p];
          b.classList.toggle('on', (prefs.bg || '') === p.bg && (prefs.win || '') === p.win && (prefs.cable || '') === p.cable);
        });
        savePrefs();
        drawCables();
      }
      // presets: eine kombination aus canvas/fenster/kabeln pro klick
      const PRESETS = {
        graphite: { bg: '', win: '', cable: '' },
        blueprint: { bg: '#1e56b0', win: '__mix', cable: '#1233c8' },
        parade: { bg: '#1a1a1a', win: '#e9e4cf', cable: '__rainbow' },
      };
      $('presetrow').addEventListener('click', (e) => {
        const b = e.target.closest('.preset');
        if (!b) return;
        Object.assign(prefs, PRESETS[b.dataset.p]);
        applyPrefs();
      });
      // randomize: nur kuratierte, garantiert lesbare kombinationen
      const RND_POOL = [
        { bg: '#0d2626', win: '#cfe0d2', cable: '#57c94f' },
        { bg: '#1d1035', win: '#e6d3d4', cable: '#ff6ad5' },
        { bg: '#2a0d12', win: '#e9e4cf', cable: '#e8791c' },
        { bg: '#008080', win: '#f4f2ec', cable: '#ffe94d' },
        { bg: '#0d1b3e', win: '#ccd6de', cable: '#4a90d9' },
        { bg: '#1a1a1a', win: '#b9bdb2', cable: '__neon' },
        { bg: '#0f2412', win: '#d9cd4e', cable: '#e8e6de' },
        { bg: '#1e56b0', win: '#d9a441', cable: '#c81111' },
        { bg: '#242424', win: '#e9e4cf', cable: '#c77dff' },
      ];
      $('swrnd').onclick = () => {
        let pick;
        do { pick = RND_POOL[Math.floor(Math.random() * RND_POOL.length)]; }
        while (pick.bg === (prefs.bg || '') && pick.win === (prefs.win || ''));
        Object.assign(prefs, pick);
        applyPrefs();
      };
      // grid + sag
      $('gridtoggle').addEventListener('change', (e) => {
        if (e.target.checked) delete prefs.grid; else prefs.grid = false;
        applyPrefs();
      });
      $('sagslider').addEventListener('input', (e) => {
        prefs.sag = Number(e.target.value);
        if (prefs.sag === 100) delete prefs.sag;
        applyPrefs();
      });

      // ---------- layout: speichern / sperren / zurücksetzen ----------
      $('laysave').onclick = () => {
        const lay = {};
        document.querySelectorAll('.win, #trashicon').forEach((w) => {
          lay[w.id] = [w.offsetLeft, w.offsetTop, w.offsetWidth];
        });
        prefs.layout = lay;
        savePrefs();
        $('laysave').textContent = 'saved.';
        setTimeout(() => ($('laysave').textContent = 'save layout'), 1200);
      };
      $('layreset').onclick = () => {
        delete prefs.layout;
        savePrefs();
        location.reload();
      };
      const syncLock = () => $('laylock').classList.toggle('on', !!prefs.lock);
      $('laylock').onclick = () => {
        prefs.lock = !prefs.lock;
        if (!prefs.lock) delete prefs.lock;
        savePrefs();
        syncLock();
      };
      syncLock();
      // gespeichertes layout vor der start-kamera anwenden
      if (prefs.layout) {
        for (const [id, v] of Object.entries(prefs.layout)) {
          const el = $(id);
          if (!el || !Array.isArray(v)) continue;
          el.style.left = v[0] + 'px';
          el.style.top = v[1] + 'px';
          if (el.classList.contains('resizable')) el.style.width = v[2] + 'px';
        }
      }
      for (const [rowId, key] of [['bgswatches', 'bg'], ['winswatches', 'win'], ['cableswatches', 'cable']]) {
        $(rowId).addEventListener('click', (e) => {
          const s = e.target.closest('.swatch');
          if (!s) return;
          prefs[key] = s.dataset.v;
          applyPrefs();
        });
      }
      $('swreset').onclick = () => {
        delete prefs.bg; delete prefs.win; delete prefs.cable;
        applyPrefs();
      };

      // ---------- start ----------
      applyPrefs();
      applyOpen();
      renderViewer();
      if (isWide()) fit();
      window.addEventListener('resize', drawCables);

      // permalink: /#werk-slug lädt das jahr des werks und öffnet es im fullscreen
      const hashSlug = decodeURIComponent(location.hash.slice(1));
      if (hashSlug) {
        const w = DATA.all.find((x) => x.slug === hashSlug);
        if (w) {
          selection = DATA.byYear[w.year] || DATA.all;
          srcLabel = String(w.year);
          const idx = selection.findIndex((x) => x.slug === w.slug);
          page = Math.max(0, Math.floor(idx / slots));
          renderViewer();
          showLb(idx);
        }
      }
    </script>
  </body>
</html>
