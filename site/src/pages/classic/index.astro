---
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import WorkFigure from '../../components/WorkFigure.astro';
import { SITE, featuredWorks, url } from '../../data/site.js';

const latest = featuredWorks.slice(0, 6);
---

<Base breadcrumb="~/classic">
  <p class="dim">last login: {SITE.span} on ttys001</p>
  <h1>{SITE.series}</h1>
  <p class="dim">{SITE.span} — ai-assisted works by {SITE.name}</p>
  <p style="margin-top:1rem"><a href={url('/')}>$ ./open canvas view</a> <span class="dim">— zoomable node graph (default)</span></p>

  <h2>selected</h2>
  <div class="grid">
    {latest.map((w, i) => <WorkFigure work={w} loading={i < 3 ? 'eager' : 'lazy'} />)}
  </div>
  <p style="margin-top:1rem">
    <a href={url('/selected-works/')}>browse all selected works &rarr;</a>
  </p>

  <Lightbox />
</Base>
